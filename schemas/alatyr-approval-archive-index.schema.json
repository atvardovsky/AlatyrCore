{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-approval-archive-index.schema.json",
  "title": "Alatyr approval archive index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_kind", "shards"],
  "properties": {
    "schema_version": {"const": 1},
    "index_kind": {"const": "target-approval-archive-index"},
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "directory", "record_count", "digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
          "directory": {"type": "string", "pattern": "^\\.ai/assistant/approvals/archive/[0-9]{4}-[0-9]{2}$"},
          "record_count": {"type": "integer", "minimum": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
