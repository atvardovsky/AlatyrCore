{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-relationship-candidates.schema.json",
  "title": "Alatyr non-authoritative relationship candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "records"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "record_kind": {"const": "target-consistency-relationship-candidates"},
    "records": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "source_node", "target_node", "relationship_type", "evidence", "observed_revision", "decision_owner"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "state": {"enum": ["observed", "proposed", "accepted", "rejected", "stale", "contradicted", "removed"]},
          "source_node": {"type": "string", "minLength": 1},
          "target_node": {"type": "string", "minLength": 1},
          "relationship_type": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "observed_revision": {"type": "string", "minLength": 1},
          "decision_owner": {"type": "string", "minLength": 1},
          "reviewed_warning": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "document", "finding_ref", "comparison_sources", "source_review"],
            "properties": {
              "kind": {"const": "stale-document"},
              "document": {"type": "string", "minLength": 1},
              "finding_ref": {"type": "string", "minLength": 1},
              "comparison_sources": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "source_review": {"type": "object"}
            }
          }
        }
      }
    }
  },
  "allOf": [{"if": {"properties": {"schema_version": {"const": 1}}}, "then": {"properties": {"records": {"items": {"not": {"required": ["reviewed_warning"]}}}}}}]
}
