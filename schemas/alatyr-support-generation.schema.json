{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-support-generation.schema.json",
  "title": "Alatyr target support-generation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_kind", "artifacts"],
  "properties": {
    "schema_version": {"const": 2},
    "registry_kind": {"const": "target-support-generation-registry"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "mode", "inputs", "outputs", "depends_on", "generator", "validation", "approval_trigger"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "mode": {"enum": ["deterministic-derived", "assistant-proposed", "owner-maintained"]},
          "inputs": {"type": "array", "minItems": 1},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "generator": {"type": "object"},
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/definitions/validation"}
          },
          "approval_trigger": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "definitions": {
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "required"],
      "properties": {
        "kind": {"enum": ["command", "manual"]},
        "required": {"type": "boolean"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "command"}}},
          "then": {"required": ["command"], "not": {"required": ["evidence"]}}
        },
        {
          "if": {"properties": {"kind": {"const": "manual"}}},
          "then": {"required": ["evidence"], "not": {"required": ["command"]}}
        }
      ]
    }
  }
}
