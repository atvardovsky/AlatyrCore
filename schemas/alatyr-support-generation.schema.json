{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-support-generation.schema.json",
  "title": "Alatyr target support-generation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_kind", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_kind": {"const": "target-support-generation-registry"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "mode", "inputs", "outputs", "depends_on", "generator", "validation", "approval_trigger"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "mode": {"enum": ["deterministic-derived", "assistant-proposed", "owner-maintained"]},
          "inputs": {"type": "array", "minItems": 1},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "generator": {"type": "object"},
          "validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "approval_trigger": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
