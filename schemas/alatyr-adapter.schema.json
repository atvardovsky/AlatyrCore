{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-adapter.schema.json",
  "title": "Alatyr target adapter manifest",
  "type": "object",
  "required": [
    "schema_version",
    "framework",
    "installation",
    "owner",
    "supported_assistants",
    "contours",
    "source_of_truth",
    "support_information",
    "context_routing",
    "modules",
    "validation",
    "operations",
    "maturity",
    "known_gaps",
    "local_deviations"
  ],
  "properties": {
    "schema_version": {"type": ["integer", "string"]},
    "framework": {
      "type": "object",
      "required": ["name", "version", "source", "template_version", "pack", "rule_registry"],
      "properties": {
        "name": {"const": "Alatyr Core"},
        "version": {"type": "string"},
        "source": {"type": "string"},
        "template_version": {"type": ["integer", "string"]},
        "pack": {"type": "string"},
        "rule_registry": {"type": "string"}
      }
    },
    "installation": {
      "type": "object",
      "required": ["id", "date", "mode", "support_profile", "state", "state_record", "discovery_report"],
      "properties": {
        "state": {
          "enum": ["scaffolded", "staged", "accepted", "degraded"]
        },
        "state_record": {"type": "string", "minLength": 1},
        "discovery_report": {"const": ".ai/assistant/discovery-report.json"}
      }
    },
    "owner": {
      "type": "object",
      "required": ["responsible_team", "technical_owner", "backup_owner", "last_review_date", "review_cadence", "review_triggers"],
      "properties": {
        "review_triggers": {"$ref": "#/definitions/nonEmptyStringArray"}
      }
    },
    "supported_assistants": {"$ref": "#/definitions/nonEmptyStringArray"},
    "contours": {
      "type": "object",
      "required": ["framework", "project", "assistant"]
    },
    "source_of_truth": {
      "type": "object",
      "required": ["project_contour", "registry", "assistant_contour", "context_router", "bootstrap_index", "bootstrap_integrity", "framework_context_index", "project_context_index", "assistant_context_index", "semantic_codebook", "agent_entry_packet", "context_profiles", "module_profile", "project_sources"],
      "properties": {
        "project_sources": {"$ref": "#/definitions/nonEmptyStringArray"}
      }
    },
    "support_information": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "state"],
      "properties": {
        "policy": {"const": ".ai/project/support-policy.json"},
        "state": {"const": ".ai/support-state.json"}
      }
    },
    "context_routing": {
      "type": "object",
      "required": ["router_schema_version", "preloaded_context", "compact_bootstrap", "agent_entry_packet_schema_version", "agent_entry_packet", "bootstrap_max_files", "bootstrap_max_words", "bootstrap_max_characters", "profile_default_max_files", "profile_default_max_total_words", "profile_default_max_portable_words", "profile_default_reserved_target_words", "profile_default_max_total_characters", "budget_behavior", "recursive_index_schema_version", "recursive_index_max_depth", "semantic_codebook_schema_version", "semantic_preload_policy", "context_packet_schema_version", "context_packet_template"],
      "properties": {
        "router_schema_version": {"const": 13},
        "preloaded_context": {"$ref": "#/definitions/nonEmptyStringArray"},
        "compact_bootstrap": {"$ref": "#/definitions/nonEmptyStringArray"},
        "agent_entry_packet_schema_version": {"const": 6},
        "agent_entry_packet": {"const": ".ai/assistant/entry-packet.json"},
        "bootstrap_max_characters": {"type": "integer", "minimum": 1},
        "profile_default_max_total_characters": {"type": "integer", "minimum": 1},
        "recursive_index_schema_version": {"const": 1},
        "recursive_index_max_depth": {"type": "integer", "minimum": 1},
        "semantic_codebook_schema_version": {"const": 2},
        "semantic_preload_policy": {"type": "string", "minLength": 1},
        "context_packet_schema_version": {"const": 4},
        "context_packet_template": {"type": "string", "minLength": 1}
      }
    },
    "modules": {
      "type": "object",
      "required": ["core_profile", "selected", "staged", "enabled", "deferred", "blocked"],
      "properties": {
        "selected": {"$ref": "#/definitions/stringArray"},
        "staged": {"$ref": "#/definitions/stringArray"},
        "enabled": {"$ref": "#/definitions/stringArray"},
        "deferred": {"$ref": "#/definitions/stringArray"},
        "blocked": {"$ref": "#/definitions/stringArray"}
      }
    },
    "validation": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "command", "required_for"],
            "properties": {
              "name": {"type": "string"},
              "command": {"type": "string"},
              "required_for": {"$ref": "#/definitions/nonEmptyStringArray"}
            }
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "required": ["gate_index", "help", "operation_request", "output_contracts", "action_authorization_policy", "session_continuity_policy", "session_continuity_flow", "session_continuity_gate", "session_continuity_packet", "session_continuity_packet_schema", "task_decomposition", "task_decomposition_schema", "task_decomposition_plan", "analysis_strategy_index", "problem_model_template", "problem_model_schema", "problem_model_projection_template", "problem_model_projection_schema", "delegation_policy_schema", "delegation_execution_tree_schema", "delegation_worker_result_schema", "delegation_branch_envelope_schema", "delegation_branch_checkpoint_schema"],
      "properties": {
        "session_continuity_policy": {"const": ".ai/assistant/policies/session-continuity.json"},
        "session_continuity_flow": {"const": ".ai/assistant/flows/session-continuity.flow.md"},
        "session_continuity_gate": {"const": ".ai/assistant/gates/session-continuity.md"},
        "session_continuity_packet": {"const": ".ai/assistant/templates/session-continuity-packet.json"},
        "session_continuity_packet_schema": {"const": 3},
        "task_decomposition_schema": {"const": 2},
        "analysis_strategy_index": {"const": ".ai/assistant/analysis-strategies/index.json"},
        "problem_model_template": {"const": ".ai/assistant/templates/problem-model.json"},
        "problem_model_schema": {"const": 2},
        "problem_model_projection_template": {"const": ".ai/assistant/templates/problem-model-active-projection.json"},
        "problem_model_projection_schema": {"const": 1},
        "delegation_policy_schema": {"const": 6},
        "delegation_execution_tree_schema": {"const": 3},
        "delegation_worker_result_schema": {"const": 2},
        "delegation_branch_envelope_schema": {"const": 2},
        "delegation_branch_checkpoint_schema": {"const": 2}
      }
    },
    "engineering_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "index", "records", "flow", "gate", "machine_template", "storage_mode", "external_patch_policy", "retention_policy", "redaction_policy"],
      "properties": {
        "contract_version": {"const": 3},
        "index": {"type": "string", "minLength": 1},
        "records": {"type": "string", "minLength": 1},
        "flow": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "minLength": 1},
        "machine_template": {"type": "string", "minLength": 1},
        "storage_mode": {"type": "string", "minLength": 1},
        "external_patch_policy": {"type": "string", "minLength": 1},
        "retention_policy": {"type": "string", "minLength": 1},
        "redaction_policy": {"type": "string", "minLength": 1}
      }
    },
    "project_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "index", "route_shards", "promotions", "routing", "flow", "gate", "promotion_template", "route_shard_template", "owner", "review_policy", "retention_policy", "redaction_policy"],
      "properties": {
        "contract_version": {"const": 3},
        "index": {"type": "string", "minLength": 1},
        "route_shards": {"type": "string", "minLength": 1},
        "promotions": {"type": "string", "minLength": 1},
        "routing": {"type": "string", "minLength": 1},
        "flow": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "minLength": 1},
        "promotion_template": {"type": "string", "minLength": 1},
        "route_shard_template": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "review_policy": {"type": "string", "minLength": 1},
        "retention_policy": {"type": "string", "minLength": 1},
        "redaction_policy": {"type": "string", "minLength": 1}
      }
    },
    "debug_mode": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["contract_version", "index", "records", "overlay", "flow", "gate", "record_template", "summary_template"],
      "properties": {
        "contract_version": {"const": 6},
        "index": {"type": "string", "minLength": 1},
        "records": {"type": "string", "minLength": 1},
        "overlay": {"type": "string", "minLength": 1},
        "flow": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "minLength": 1},
        "record_template": {"type": "string", "minLength": 1},
        "summary_template": {"type": "string", "minLength": 1}
      }
    },
    "maturity": {"type": "object", "required": ["profile"]},
    "approvals": {"type": "object", "required": ["directory", "template", "machine_template"]},
    "dependency_knowledge": {
      "type": ["object", "null"],
      "properties": {
        "index": {"type": "string", "minLength": 1},
        "policy": {"type": "string", "minLength": 1},
        "catalog": {"type": "string", "minLength": 1},
        "lock": {"type": "string", "minLength": 1},
        "deviations": {"type": "string", "minLength": 1},
        "snapshots": {"type": "string", "minLength": 1},
        "intent": {"type": "string", "minLength": 1},
        "flow": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "minLength": 1},
        "report": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "workspace_modes": {
      "type": ["object", "null"],
      "properties": {
        "index": {"type": "string", "minLength": 1},
        "catalog": {"type": "string", "minLength": 1},
        "root_context": {"type": "string", "minLength": 1},
        "modes": {"type": "string", "minLength": 1},
        "mode_template": {"type": "string", "minLength": 1},
        "intent": {"type": "string", "minLength": 1},
        "flow": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "minLength": 1},
        "suggestion": {"type": "string", "minLength": 1},
        "preflight": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "known_gaps": {"$ref": "#/definitions/stringArray"},
    "local_deviations": {"$ref": "#/definitions/stringArray"}
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
