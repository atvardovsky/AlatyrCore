{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alatyr target assistant surface capability record",
  "type": "object",
  "required": [
    "schema_version",
    "capability_kind",
    "assistant_surface",
    "surface_state",
    "instruction_loading",
    "skills",
    "tool_permissions",
    "context_caching",
    "diagram_discussion",
    "subagent_delegation"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "capability_kind": {"const": "target-assistant-surface-capabilities"},
    "assistant_surface": {"type": "string", "minLength": 1},
    "surface_state": {"$ref": "#/definitions/surfaceState"},
    "instruction_loading": {"$ref": "#/definitions/instructionLoading"},
    "skills": {"$ref": "#/definitions/skills"},
    "tool_permissions": {"$ref": "#/definitions/toolPermissions"},
    "context_caching": {"$ref": "#/definitions/contextCaching"},
    "diagram_discussion": {"type": "object"},
    "subagent_delegation": {"type": "object"}
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "required": ["verified_at", "client_version", "evidence", "expires_at", "review_triggers"],
      "properties": {
        "verified_at": {"type": "string", "minLength": 1},
        "client_version": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1},
        "review_triggers": {"$ref": "#/definitions/stringArray"}
      }
    },
    "surfaceState": {
      "type": "object",
      "required": [
        "overall",
        "selected_for_target",
        "evidence_state",
        "advertised_by_surface",
        "verified_for_target",
        "limitations",
        "review_triggers"
      ],
      "properties": {
        "overall": {"type": "string", "minLength": 1},
        "selected_for_target": {"type": "string", "minLength": 1},
        "evidence_state": {"type": "string", "minLength": 1},
        "advertised_by_surface": {"type": "string", "minLength": 1},
        "verified_for_target": {"type": "string", "minLength": 1},
        "limitations": {"$ref": "#/definitions/stringArray"},
        "review_triggers": {"$ref": "#/definitions/stringArray"}
      },
      "additionalProperties": false
    },
    "instructionLoading": {
      "allOf": [
        {"$ref": "#/definitions/evidence"},
        {
          "type": "object",
          "required": ["route", "runtime_variant", "selected_entry_path", "competing_sources", "auto_load_observed", "precedence_evidence", "configuration_state"],
          "properties": {
            "route": {"type": "string", "minLength": 1},
            "runtime_variant": {"type": "string", "minLength": 1},
            "selected_entry_path": {"type": "string", "minLength": 1},
            "competing_sources": {"$ref": "#/definitions/stringArray"},
            "auto_load_observed": {"type": "string", "minLength": 1},
            "precedence_evidence": {"type": "string", "minLength": 1},
            "configuration_state": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "skills": {
      "allOf": [
        {"$ref": "#/definitions/evidence"},
        {
          "type": "object",
          "required": ["route", "discovery_paths", "selected_source", "activation_mode"],
          "properties": {
            "route": {"type": "string", "minLength": 1},
            "discovery_paths": {"$ref": "#/definitions/stringArray"},
            "selected_source": {"type": "string", "minLength": 1},
            "activation_mode": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "toolPermissions": {
      "allOf": [
        {"$ref": "#/definitions/evidence"},
        {
          "type": "object",
          "required": ["client_permission_mode", "effective_restrictions", "alatyr_authorization_separate"],
          "properties": {
            "client_permission_mode": {"type": "string", "minLength": 1},
            "effective_restrictions": {"type": "string", "minLength": 1},
            "alatyr_authorization_separate": {"const": true}
          }
        }
      ]
    },
    "contextCaching": {
      "allOf": [
        {"$ref": "#/definitions/evidence"},
        {
          "type": "object",
          "required": [
            "route",
            "provider",
            "model",
            "provider_cache_mode",
            "client_control_exposure",
            "client_telemetry_exposure",
            "retention",
            "minimum_cacheable_tokens",
            "stable_prefix_ordering",
            "context_window_reduction",
            "fallback"
          ],
          "properties": {
            "route": {"type": "string", "minLength": 1},
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "provider_cache_mode": {"type": "string", "minLength": 1},
            "client_control_exposure": {"type": "string", "minLength": 1},
            "client_telemetry_exposure": {"type": "string", "minLength": 1},
            "retention": {"type": "string", "minLength": 1},
            "minimum_cacheable_tokens": {"type": "string", "minLength": 1},
            "stable_prefix_ordering": {"const": true},
            "context_window_reduction": {"const": false},
            "fallback": {"const": "bounded-context-routing"}
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
