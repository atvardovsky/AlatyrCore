{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "alatyr-publication-receipt.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_kind", "task_id", "operation_id", "remote_ref", "observed_revision", "observed_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_kind": {"const": "alatyr-publication-receipt"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[^{}]+$"},
    "operation_id": {"type": "string", "minLength": 1, "pattern": "^[^{}]+$"},
    "remote_ref": {"type": "string", "pattern": "^refs/remotes/[^\\s]+/[^\\s]+$"},
    "observed_revision": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "observed_at": {"type": "string", "minLength": 1}
  }
}
