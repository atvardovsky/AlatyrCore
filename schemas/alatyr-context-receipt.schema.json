{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alatyr.dev/schemas/alatyr-context-receipt.schema.json",
  "title": "Alatyr Context Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "measurement_state",
    "planned",
    "resolved",
    "observed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_kind": {"const": "alatyr-context-receipt"},
    "measurement_state": {"enum": ["planned", "resolved", "observed"]},
    "planned": {"$ref": "#/$defs/contextPlan"},
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "paths", "approximate_words"],
      "properties": {
        "status": {"enum": ["recorded", "unavailable"]},
        "paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "approximate_words": {"$ref": "#/$defs/countOrUnknown"}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_level",
        "source",
        "files_loaded",
        "input_tokens",
        "output_tokens",
        "evidence"
      ],
      "properties": {
        "evidence_level": {"enum": ["exact", "partial", "unavailable"]},
        "source": {
          "enum": [
            "host-telemetry",
            "provider-usage",
            "assistant-reported",
            "manual",
            "unavailable"
          ]
        },
        "files_loaded": {"$ref": "#/$defs/countOrUnknown"},
        "input_tokens": {"$ref": "#/$defs/countOrUnknown"},
        "output_tokens": {"$ref": "#/$defs/countOrUnknown"},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "countOrUnknown": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"const": "unknown"}
      ]
    },
    "contextPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "approximate_words"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "approximate_words": {"$ref": "#/$defs/countOrUnknown"}
      }
    }
  }
}
