{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "alatyr-evidence-loss-approval.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_kind", "decision", "scope", "granted_by", "reviewed_at", "tasks", "original_outcomes_accepted", "execution_authorized"],
  "properties": {
    "schema_version": {"const": 1}, "record_kind": {"const": "alatyr-evidence-loss-approval"},
    "decision": {"const": "approved"}, "scope": {"const": "historical-classification-only"},
    "granted_by": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^{}]+$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "original_outcomes_accepted": {"const": false}, "execution_authorized": {"const": false},
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "operation_id", "problem_model", "registration"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1, "maxLength": 1024},
          "operation_id": {"type": "string", "minLength": 1, "maxLength": 1024},
          "problem_model": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          },
          "registration": {
            "type": "object", "additionalProperties": false, "required": ["commit", "index_sha256"],
            "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        }
      }
    }
  }
}
