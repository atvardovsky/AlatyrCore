{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-delegation-branch-envelope.schema.json",
  "title": "Alatyr primary-approved delegation branch envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "envelope_kind", "envelope_id", "operation_id",
    "root_packet_id", "parent_node_id", "issued_by", "base_revision",
    "authorized_phases", "max_depth", "max_children", "max_context_words",
    "max_result_words", "max_summary_words", "max_retries",
    "allowed_actions", "write_scope", "allowed_tools", "allowed_surface_refs",
    "semantic_scope", "coverage_prefix", "context_packet_sha256",
    "capability_evidence_sha256", "required_validation", "expires_at",
    "envelope_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "envelope_kind": {"const": "alatyr-delegation-branch-envelope"},
    "envelope_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "root_packet_id": {"type": "string", "minLength": 1},
    "parent_node_id": {"type": "string", "minLength": 1},
    "issued_by": {"const": "primary-assistant"},
    "base_revision": {"type": "string", "minLength": 1},
    "authorized_phases": {"const": ["inspect"]},
    "max_depth": {"const": 2},
    "max_children": {"type": "integer", "minimum": 1, "maximum": 4},
    "max_context_words": {"type": "integer", "minimum": 1, "maximum": 24000},
    "max_result_words": {"type": "integer", "minimum": 1, "maximum": 12000},
    "max_summary_words": {"type": "integer", "minimum": 1, "maximum": 4000},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 2},
    "allowed_actions": {"const": ["inspect"]},
    "write_scope": {"const": "none"},
    "allowed_tools": {"$ref": "#/definitions/stringList"},
    "allowed_surface_refs": {"$ref": "#/definitions/stringList"},
    "semantic_scope": {"type": "string", "minLength": 1},
    "coverage_prefix": {"type": "string", "minLength": 1},
    "context_packet_sha256": {"anyOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
    "capability_evidence_sha256": {"$ref": "#/definitions/sha256"},
    "required_validation": {"$ref": "#/definitions/stringList"},
    "expires_at": {"type": "string", "minLength": 1},
    "envelope_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
