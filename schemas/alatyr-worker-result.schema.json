{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-worker-result.schema.json",
  "title": "Alatyr normalized worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_kind", "result_id", "packet_id",
    "parent_packet_id", "node_id", "depth", "base_revision", "status",
    "measurement_state", "input_context_packet_sha256", "raw_payload",
    "accepted_summary", "summary_covers_result_ids", "child_result_sha256",
    "evidence_manifest", "touched_surfaces", "tools_used", "scope_violation",
    "authorization_concern", "proof_obligation_ids",
    "satisfied_proof_obligation_ids", "validation", "stop_reason_id",
    "subtree_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "result_kind": {"const": "alatyr-normalized-worker-result"},
    "result_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "parent_packet_id": {"type": ["string", "null"], "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "depth": {"type": "integer", "minimum": 1, "maximum": 2},
    "base_revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "blocked", "cancelled", "requires-review", "rejected"]},
    "measurement_state": {"const": "observed"},
    "input_context_packet_sha256": {"anyOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
    "raw_payload": {"$ref": "#/definitions/artifact"},
    "accepted_summary": {"$ref": "#/definitions/artifact"},
    "summary_covers_result_ids": {"$ref": "#/definitions/stringList"},
    "child_result_sha256": {"type": "array", "items": {"$ref": "#/definitions/sha256"}, "uniqueItems": true},
    "evidence_manifest": {"type": "array", "items": {"$ref": "#/definitions/evidence"}},
    "touched_surfaces": {"$ref": "#/definitions/stringList"},
    "tools_used": {"$ref": "#/definitions/stringList"},
    "scope_violation": {"type": "string", "minLength": 1},
    "authorization_concern": {"type": "string", "minLength": 1},
    "proof_obligation_ids": {"$ref": "#/definitions/stringList"},
    "satisfied_proof_obligation_ids": {"$ref": "#/definitions/stringList"},
    "validation": {"$ref": "#/definitions/stringList"},
    "stop_reason_id": {"type": "string", "minLength": 1},
    "subtree_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "word_count", "character_count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "word_count": {"type": "integer", "minimum": 0},
        "character_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "sha256", "validation"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "validation": {"type": "string", "minLength": 1}
      }
    }
  }
}
