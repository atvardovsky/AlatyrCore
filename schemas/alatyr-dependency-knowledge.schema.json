{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-dependency-knowledge.schema.json",
  "title": "Alatyr passive dependency knowledge export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_kind",
    "knowledge_api",
    "package",
    "compatibility",
    "export_root",
    "exports",
    "public_dependencies",
    "prohibited_surfaces"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package_kind": {"const": "alatyr-dependency-knowledge"},
    "knowledge_api": {"const": 1},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "source", "release_profile", "license"],
      "properties": {
        "ecosystem": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "release_profile": {"enum": ["consumer", "full-source"]},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_capabilities"],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "export_root": {"const": "exports"},
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "content_digest", "authority", "stability", "summary", "applicability", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"},
          "type": {"enum": ["public-contract", "architecture", "vocabulary", "configuration", "migration", "validation-guidance"]},
          "path": {"type": "string", "pattern": "^exports/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "authority": {"enum": ["upstream-canonical", "upstream-derived", "observed", "third-party"]},
          "stability": {"enum": ["stable", "experimental", "deprecated", "internal"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "conditions"],
            "properties": {
              "state": {"enum": ["active", "inactive", "conditional"]},
              "conditions": {
                "type": "array",
                "items": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "public_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "relationship", "version_constraint", "required_export_ids"],
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "relationship": {"enum": ["public-contract", "optional", "peer", "plugin", "integration"]},
          "version_constraint": {"type": "string", "minLength": 1},
          "required_export_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "prohibited_surfaces": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"const": "assistant-bridges"}},
        {"contains": {"const": "prompts"}},
        {"contains": {"const": "skills"}},
        {"contains": {"const": "gates"}},
        {"contains": {"const": "tools"}},
        {"contains": {"const": "permissions"}},
        {"contains": {"const": "lifecycle-hooks"}},
        {"contains": {"const": "executable-commands"}}
      ],
      "items": {"type": "string", "minLength": 1}
    }
  }
}
