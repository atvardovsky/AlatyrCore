{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-consistency-map-shard.schema.json",
  "title": "Alatyr target consistency-map area shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "shard_kind", "id", "project_area", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "shard_kind": {"const": "target-consistency-map-shard"},
    "id": {"type": "string", "minLength": 1},
    "project_area": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fact_type", "level", "project_area", "canonical_owner", "coverage_state", "coverage_evidence", "bindings", "relationships"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "fact_type": {"type": "string", "minLength": 1},
          "level": {"enum": ["fact", "contract", "area", "system", "adapter", "surface"]},
          "project_area": {"type": "string", "minLength": 1},
          "canonical_owner": {"type": "string", "minLength": 1},
          "coverage_state": {"enum": ["mapped", "isolated-verified", "known-gap"]},
          "coverage_evidence": {"type": "array", "items": {"type": "string"}},
          "bindings": {"type": "array"},
          "relationships": {"type": "array"}
        }
      }
    }
  }
}
