{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-delegation-execution-tree.schema.json",
  "title": "Alatyr delegation execution tree evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tree_kind",
    "operation_id",
    "base_revision",
    "current_user_authorization",
    "task_profile",
    "policy_revision",
    "capability_evidence",
    "aggregate_budget",
    "root_node_id",
    "nodes",
    "edges",
    "primary_convergence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "tree_kind": {"const": "alatyr-delegation-execution-tree"},
    "operation_id": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 1},
    "current_user_authorization": {"type": "object"},
    "task_profile": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "minLength": 1},
    "capability_evidence": {"type": "string", "minLength": 1},
    "aggregate_budget": {"$ref": "#/definitions/aggregateBudget"},
    "root_node_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/definitions/edge"}
    },
    "primary_convergence": {"$ref": "#/definitions/primaryConvergence"}
  },
  "definitions": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "aggregateBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_delegates",
        "max_parallel_delegates",
        "max_children_per_parent",
        "max_context_words_total",
        "max_retries_total",
        "used_total_delegates",
        "used_parallel_delegates",
        "used_context_words",
        "used_retries"
      ],
      "properties": {
        "max_total_delegates": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_parallel_delegates": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_children_per_parent": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_context_words_total": {"type": "integer", "minimum": 1, "maximum": 24000},
        "max_retries_total": {"type": "integer", "minimum": 0, "maximum": 2},
        "used_total_delegates": {"type": "integer", "minimum": 0, "maximum": 8},
        "used_parallel_delegates": {"type": "integer", "minimum": 0, "maximum": 8},
        "used_context_words": {"type": "integer", "minimum": 0, "maximum": 24000},
        "used_retries": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "parent_node_id",
        "packet_id",
        "result_id",
        "depth",
        "status",
        "role_id",
        "assistant_surface",
        "dispatch_backend",
        "implementation_level",
        "coverage_key",
        "semantic_scope",
        "changed_fact_ids",
        "canonical_owner_refs",
        "surface_refs",
        "relationship_refs",
        "allowed_actions",
        "write_scope",
        "context_words",
        "attempt",
        "result_status",
        "stop_reason_id",
        "child_proposals",
        "overlap_decision"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "parent_node_id": {"type": ["string", "null"], "minLength": 1},
        "packet_id": {"type": ["string", "null"], "minLength": 1},
        "result_id": {"type": ["string", "null"], "minLength": 1},
        "depth": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {
          "enum": [
            "PLANNED",
            "BLOCKED",
            "READY",
            "RUNNING",
            "REVIEW_REQUIRED",
            "DONE",
            "FAILED",
            "CANCELLED",
            "REJECTED"
          ]
        },
        "role_id": {"type": "string", "minLength": 1},
        "assistant_surface": {"type": "string", "minLength": 1},
        "dispatch_backend": {"type": "string", "minLength": 1},
        "implementation_level": {"type": "string", "minLength": 1},
        "coverage_key": {"type": "string", "minLength": 1},
        "semantic_scope": {"type": "string", "minLength": 1},
        "changed_fact_ids": {"$ref": "#/definitions/stringList"},
        "canonical_owner_refs": {"$ref": "#/definitions/stringList"},
        "surface_refs": {"$ref": "#/definitions/stringList"},
        "relationship_refs": {"$ref": "#/definitions/stringList"},
        "allowed_actions": {"$ref": "#/definitions/stringList"},
        "write_scope": {"type": "string", "minLength": 1},
        "context_words": {"type": "integer", "minimum": 0, "maximum": 24000},
        "attempt": {"type": "integer", "minimum": 0, "maximum": 2},
        "result_status": {"type": ["string", "null"], "minLength": 1},
        "stop_reason_id": {"type": ["string", "null"], "minLength": 1},
        "child_proposals": {"type": "array"},
        "overlap_decision": {
          "enum": [
            "disjoint",
            "primary-reconciled-overlap",
            "rejected-overlap",
            "not-applicable"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_node_id", "child_node_id", "edge_kind"],
      "properties": {
        "parent_node_id": {"type": "string", "minLength": 1},
        "child_node_id": {"type": "string", "minLength": 1},
        "edge_kind": {"const": "primary-approved-dispatch"}
      }
    },
    "primaryConvergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_result_ids",
        "rejected_result_ids",
        "combined_validation",
        "logical_integrity_review",
        "residual_risk",
        "final_stop_reason_id"
      ],
      "properties": {
        "status": {"enum": ["pending", "completed", "blocked", "cancelled"]},
        "reviewed_result_ids": {"$ref": "#/definitions/stringList"},
        "rejected_result_ids": {"$ref": "#/definitions/stringList"},
        "combined_validation": {"type": "string", "minLength": 1},
        "logical_integrity_review": {"type": "string", "minLength": 1},
        "residual_risk": {"type": "string", "minLength": 1},
        "final_stop_reason_id": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
