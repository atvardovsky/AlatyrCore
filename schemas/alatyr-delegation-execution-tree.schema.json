{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-delegation-execution-tree.schema.json",
  "title": "Alatyr delegation execution tree evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tree_kind",
    "operation_id",
    "recorded_at",
    "base_revision",
    "current_user_authorization",
    "task_profile",
    "analysis_strategy_id",
    "problem_model_sha256",
    "policy_revision",
    "capability_evidence",
    "capability_evidence_sha256",
    "aggregate_budget",
    "root_node_id",
    "nodes",
    "edges",
    "primary_convergence"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "tree_kind": {"const": "alatyr-delegation-execution-tree"},
    "operation_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 1},
    "current_user_authorization": {"$ref": "#/definitions/currentAuthorization"},
    "task_profile": {"type": "string", "minLength": 1},
    "analysis_strategy_id": {"type": "string", "minLength": 1},
    "problem_model_sha256": {"anyOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
    "policy_revision": {"$ref": "#/definitions/sha256"},
    "capability_evidence": {"type": "string", "minLength": 1},
    "capability_evidence_sha256": {"$ref": "#/definitions/sha256"},
    "aggregate_budget": {"$ref": "#/definitions/aggregateBudget"},
    "root_node_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/definitions/edge"}
    },
    "primary_convergence": {"$ref": "#/definitions/primaryConvergence"}
  },
  "definitions": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "currentAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "allowed_actions", "authorized_phases", "approval_record"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "allowed_actions": {"$ref": "#/definitions/stringList"},
        "authorized_phases": {
          "type": "array",
          "minItems": 1,
          "contains": {"const": "inspect"},
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "approval_record": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "aggregateBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_delegates",
        "max_parallel_delegates",
        "max_children_per_parent",
        "max_context_words_total",
        "max_result_words_total",
        "max_primary_summary_words_total",
        "max_retries_total",
        "used_total_delegates",
        "used_parallel_delegates",
        "used_context_words",
        "used_result_words",
        "used_primary_summary_words",
        "used_retries"
      ],
      "properties": {
        "max_total_delegates": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_parallel_delegates": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_children_per_parent": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_context_words_total": {"type": "integer", "minimum": 1, "maximum": 24000},
        "max_result_words_total": {"type": "integer", "minimum": 1, "maximum": 12000},
        "max_primary_summary_words_total": {"type": "integer", "minimum": 1, "maximum": 4000},
        "max_retries_total": {"type": "integer", "minimum": 0, "maximum": 2},
        "used_total_delegates": {"type": "integer", "minimum": 0, "maximum": 8},
        "used_parallel_delegates": {"type": "integer", "minimum": 0, "maximum": 8},
        "used_context_words": {"type": "integer", "minimum": 0, "maximum": 24000},
        "used_result_words": {"type": "integer", "minimum": 0, "maximum": 12000},
        "used_primary_summary_words": {"type": "integer", "minimum": 0, "maximum": 4000},
        "used_retries": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "parent_node_id",
        "packet_id",
        "parent_packet_id",
        "result_id",
        "depth",
        "status",
        "role_id",
        "assistant_surface",
        "dispatch_backend",
        "implementation_level",
        "coverage_key",
        "semantic_scope",
        "changed_fact_ids",
        "proof_obligation_ids",
        "canonical_owner_refs",
        "surface_refs",
        "relationship_refs",
        "allowed_actions",
        "write_scope",
        "context_evidence",
        "context_words",
        "max_result_words",
        "max_summary_words",
        "dispatch_group_id",
        "branch_envelope",
        "branch_envelope_sha256",
        "branch_checkpoint",
        "branch_checkpoint_sha256",
        "result_evidence",
        "accepted_summary_evidence",
        "summary_covers_result_ids",
        "satisfied_acceptance_ids",
        "satisfied_proof_obligation_ids",
        "produced_evidence_ids",
        "attempt",
        "result_status",
        "stop_reason_id",
        "child_proposals",
        "overlap_decision"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "parent_node_id": {"type": ["string", "null"], "minLength": 1},
        "packet_id": {"type": ["string", "null"], "minLength": 1},
        "parent_packet_id": {"type": ["string", "null"], "minLength": 1},
        "result_id": {"type": ["string", "null"], "minLength": 1},
        "depth": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {
          "enum": [
            "PLANNED",
            "BLOCKED",
            "READY",
            "RUNNING",
            "REVIEW_REQUIRED",
            "DONE",
            "FAILED",
            "CANCELLED",
            "REJECTED"
          ]
        },
        "role_id": {"type": "string", "minLength": 1},
        "assistant_surface": {"type": "string", "minLength": 1},
        "dispatch_backend": {"type": "string", "minLength": 1},
        "implementation_level": {"type": "string", "minLength": 1},
        "coverage_key": {"type": "string", "minLength": 1},
        "semantic_scope": {"type": "string", "minLength": 1},
        "changed_fact_ids": {"$ref": "#/definitions/stringList"},
        "proof_obligation_ids": {"$ref": "#/definitions/stringList"},
        "canonical_owner_refs": {"$ref": "#/definitions/stringList"},
        "surface_refs": {"$ref": "#/definitions/stringList"},
        "relationship_refs": {"$ref": "#/definitions/stringList"},
        "allowed_actions": {"$ref": "#/definitions/stringList"},
        "write_scope": {"type": "string", "minLength": 1},
        "context_evidence": {"anyOf": [{"$ref": "#/definitions/artifactEvidence"}, {"type": "null"}]},
        "context_words": {"type": "integer", "minimum": 0, "maximum": 24000},
        "max_result_words": {"type": "integer", "minimum": 0, "maximum": 12000},
        "max_summary_words": {"type": "integer", "minimum": 0, "maximum": 4000},
        "dispatch_group_id": {"type": ["string", "null"], "minLength": 1},
        "branch_envelope": {"type": ["string", "null"], "minLength": 1},
        "branch_envelope_sha256": {"anyOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
        "branch_checkpoint": {"type": ["string", "null"], "minLength": 1},
        "branch_checkpoint_sha256": {"anyOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
        "result_evidence": {"anyOf": [{"$ref": "#/definitions/artifactEvidence"}, {"type": "null"}]},
        "accepted_summary_evidence": {"anyOf": [{"$ref": "#/definitions/artifactEvidence"}, {"type": "null"}]},
        "summary_covers_result_ids": {"$ref": "#/definitions/stringList"},
        "satisfied_acceptance_ids": {"$ref": "#/definitions/stringList"},
        "satisfied_proof_obligation_ids": {"$ref": "#/definitions/stringList"},
        "produced_evidence_ids": {"$ref": "#/definitions/stringList"},
        "attempt": {"type": "integer", "minimum": 0, "maximum": 2},
        "result_status": {"type": ["string", "null"], "minLength": 1},
        "stop_reason_id": {"type": ["string", "null"], "minLength": 1},
        "child_proposals": {"type": "array"},
        "overlap_decision": {
          "enum": [
            "disjoint",
            "primary-reconciled-overlap",
            "rejected-overlap",
            "not-applicable"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_node_id", "child_node_id", "edge_kind"],
      "properties": {
        "parent_node_id": {"type": "string", "minLength": 1},
        "child_node_id": {"type": "string", "minLength": 1},
        "edge_kind": {"enum": ["primary-approved-dispatch", "primary-envelope-dispatch"]}
      }
    },
    "primaryConvergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_acceptance_ids",
        "required_evidence_ids",
        "required_proof_obligation_ids",
        "satisfied_proof_obligation_ids",
        "reviewed_result_ids",
        "indirect_result_ids",
        "rejected_result_ids",
        "combined_validation",
        "logical_integrity_review",
        "residual_risk",
        "final_stop_reason_id"
      ],
      "properties": {
        "status": {"enum": ["pending", "completed", "blocked", "cancelled"]},
        "required_acceptance_ids": {"$ref": "#/definitions/stringList"},
        "required_evidence_ids": {"$ref": "#/definitions/stringList"},
        "required_proof_obligation_ids": {"$ref": "#/definitions/stringList"},
        "satisfied_proof_obligation_ids": {"$ref": "#/definitions/stringList"},
        "reviewed_result_ids": {"$ref": "#/definitions/stringList"},
        "indirect_result_ids": {"$ref": "#/definitions/stringList"},
        "rejected_result_ids": {"$ref": "#/definitions/stringList"},
        "combined_validation": {"type": "string", "minLength": 1},
        "logical_integrity_review": {"type": "string", "minLength": 1},
        "residual_risk": {"type": "string", "minLength": 1},
        "final_stop_reason_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "word_count", "character_count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "word_count": {"type": "integer", "minimum": 0},
        "character_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    }
  }
}
