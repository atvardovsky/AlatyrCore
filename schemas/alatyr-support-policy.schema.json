{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/atvardovsky/AlatyrCore/schemas/alatyr-support-policy.schema.json",
  "title": "Alatyr target support policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_kind",
    "managed_roots",
    "optional_entrypoints",
    "exclusions",
    "classifications"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_kind": {"const": "target-support-policy"},
    "managed_roots": {"$ref": "#/definitions/pathList"},
    "optional_entrypoints": {"$ref": "#/definitions/pathList"},
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "reason"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "patterns"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "classification": {
            "enum": ["exact-contract", "derived", "append-only-evidence", "local-transient"]
          },
          "patterns": {"$ref": "#/definitions/pathList"}
        }
      }
    }
  },
  "definitions": {
    "pathList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
