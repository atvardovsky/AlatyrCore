{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/repair_evidence",
  "$defs": {
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pointer": {"type": "string", "maxLength": 512, "pattern": "^/(?:[^~]|~[01])*$"},
    "scalar": {"type": ["string", "number", "boolean"]},
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["assertions", "performance"],
      "properties": {
        "assertions": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "boundary", "command_ids", "artifact_pointer", "expected", "stage", "control_pointer"],
          "properties": {
            "id": {"$ref": "#/$defs/text"},
            "boundary": {"enum": ["entrypoint", "producers-consumers", "persistence", "process-topology", "resources", "positive-preconditions"]},
            "command_ids": {"allOf": [{"$ref": "#/$defs/texts"}], "minItems": 1},
            "artifact_pointer": {"$ref": "#/$defs/pointer"},
            "expected": {"$ref": "#/$defs/scalar"},
            "stage": {"enum": ["diagnosis", "acceptance"]},
            "control_pointer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pointer"}]}
          }
        }},
        "performance": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "artifact_pointer", "unit", "direction", "max_regression_percent", "min_samples", "max_spread_percent", "comparability_pointers"],
          "properties": {
            "id": {"$ref": "#/$defs/text"},
            "artifact_pointer": {"$ref": "#/$defs/pointer"},
            "unit": {"$ref": "#/$defs/text"},
            "direction": {"enum": ["lower-is-better", "higher-is-better"]},
            "max_regression_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "min_samples": {"type": "integer", "minimum": 2, "maximum": 256},
            "max_spread_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "comparability_pointers": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/pointer"}}
          }
        }}
      }
    },
    "repair_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "acceptance_command_ids",
        "records"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [1, 2]
        },
        "state": {
          "enum": [
            "enabled",
            "deferred",
            "disabled"
          ]
        },
        "acceptance_command_ids": {
          "$ref": "#/$defs/texts"
        },
        "qualification": {"$ref": "#/$defs/qualification"},
        "records": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "path"
            ],
            "properties": {
              "task_id": {
                "$ref": "#/$defs/text"
              },
              "path": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      },
      "allOf": [{"if": {"properties": {"schema_version": {"const": 2}}}, "then": {"required": ["qualification"]}, "else": {"not": {"required": ["qualification"]}}}]
    },
    "repair_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "task_id",
        "operation_id",
        "incident_family_id",
        "policy_sha256",
        "original_case_ref",
        "claim",
        "diagnosis",
        "hypotheses",
        "fixture_boundaries",
        "attempts"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [1, 2]
        },
        "record_kind": {
          "const": "target-repair-review"
        },
        "task_id": {
          "$ref": "#/$defs/text"
        },
        "operation_id": {
          "$ref": "#/$defs/text"
        },
        "incident_family_id": {
          "$ref": "#/$defs/text"
        },
        "policy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "original_case_ref": {
          "$ref": "#/$defs/text"
        },
        "claim": {
          "enum": [
            "unverified",
            "component-only",
            "incident-fixed"
          ]
        },
        "diagnosis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hypothesis_id",
                "run_ref"
              ],
              "properties": {
                "hypothesis_id": {
                  "$ref": "#/$defs/text"
                },
                "run_ref": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          ]
        },
        "hypotheses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "falsifier"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "falsifier": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "fixture_boundaries": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state",
              "reason",
              "evidence_refs"
            ],
            "properties": {
              "id": {
                "enum": [
                  "entrypoint",
                  "producers-consumers",
                  "persistence",
                  "process-topology",
                  "resources",
                  "positive-preconditions"
                ]
              },
              "state": {
                "enum": [
                  "verified",
                  "not-applicable",
                  "unknown"
                ]
              },
              "reason": {
                "$ref": "#/$defs/text"
              },
              "evidence_refs": {
                "$ref": "#/$defs/texts"
              }
            }
          }
        },
        "repair_stage": {"enum": ["diagnostic", "qualified-repair", "acceptance"]},
        "observations": {"type": "array", "maxItems": 128, "items": {
          "type": "object", "additionalProperties": false, "required": ["assertion_id", "run_ref"],
          "properties": {"assertion_id": {"$ref": "#/$defs/text"}, "run_ref": {"$ref": "#/$defs/text"}}
        }},
        "performance_comparisons": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["metric_id", "baseline", "candidate_run_ref"],
          "properties": {
            "metric_id": {"$ref": "#/$defs/text"},
            "baseline": {"type": "object", "additionalProperties": false, "required": ["run", "policy"], "properties": {"run": {"$ref": "#/$defs/binding"}, "policy": {"$ref": "#/$defs/binding"}}},
            "candidate_run_ref": {"$ref": "#/$defs/text"}
          }
        }},
        "attempts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis_id",
              "run_ref",
              "run_sha256",
              "historical_policy",
              "failure_ref",
              "purpose",
              "failure_class",
              "expected_effect",
              "observed_effect",
              "reassessment_ref"
            ],
            "properties": {
              "hypothesis_id": {
                "$ref": "#/$defs/text"
              },
              "run_ref": {
                "$ref": "#/$defs/text"
              },
              "run_sha256": {"$ref": "#/$defs/digest"},
              "historical_policy": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
              "failure_ref": {"type": ["string", "null"], "minLength": 1},
              "purpose": {
                "enum": [
                  "diagnostic",
                  "acceptance"
                ]
              },
              "failure_class": {
                "enum": [
                  "none",
                  "production",
                  "fixture",
                  "test-author",
                  "environment",
                  "unverified"
                ]
              },
              "expected_effect": {
                "$ref": "#/$defs/text"
              },
              "observed_effect": {
                "$ref": "#/$defs/text"
              },
              "reassessment_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [{"if": {"properties": {"schema_version": {"const": 2}}}, "then": {"required": ["repair_stage", "observations", "performance_comparisons"]}, "else": {"not": {"anyOf": [{"required": ["repair_stage"]}, {"required": ["observations"]}, {"required": ["performance_comparisons"]}]}}}]
    }
  }
}
