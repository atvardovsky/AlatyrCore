{
  "schema_version": 2,
  "packet_kind": "alatyr-context-packet",
  "cache_delivery": {
    "schema_version": 1,
    "assistant_surface": "{SELECTED_ASSISTANT_SURFACE_OR_GENERIC}",
    "capability_record": ".ai/assistant/assistant-capabilities/{SELECTED_ASSISTANT_SURFACE_OR_GENERIC}.json",
    "route": "{SUPPORTED_UNSUPPORTED_OR_UNKNOWN}",
    "provider": "{TARGET_MODEL_PROVIDER_OR_UNKNOWN}",
    "model": "{TARGET_MODEL_OR_UNKNOWN}",
    "provider_cache_mode": "{AUTOMATIC_EXPLICIT_BOTH_UNSUPPORTED_OR_UNKNOWN}",
    "client_control_exposure": "{SUPPORTED_UNSUPPORTED_OR_UNKNOWN}",
    "client_telemetry_exposure": "{SUPPORTED_UNSUPPORTED_OR_UNKNOWN}",
    "stable_prefix_sections": [
      "semantic_terms"
    ],
    "dynamic_tail_sections": [
      "profile",
      "operation",
      "selected_items",
      "budget",
      "receipt"
    ],
    "stable_prefix_digest": "sha256:{STABLE_PREFIX_DIGEST}",
    "dynamic_tail_digest": "sha256:{DYNAMIC_TAIL_DIGEST}",
    "cache_hit_required": false,
    "context_window_reduction": false,
    "fallback": "bounded-context-routing"
  },
  "semantic_terms": [
    {
      "id": "{ALATYR_OR_PROJECT_TERM_ID}",
      "version": 1,
      "definition": "{RESOLVED_DEFINITION}",
      "canonical_owner": "{TARGET_RELATIVE_CANONICAL_OWNER}"
    }
  ],
  "profile": "{SELECTED_TASK_PROFILE}",
  "operation": "{SELECTED_OPERATION}",
  "task_classification": "{SMALL_TASK_STANDARD_TASK_LARGE_OR_RESUMABLE_PROTECTED_OR_SENSITIVE_OR_UNRESOLVED}",
  "selected_items": [
    {
      "id": "{CONTEXT_ITEM_ID}",
      "path": "{TARGET_RELATIVE_PATH}",
      "content_digest": "sha256:{CONTENT_DIGEST}",
      "reason": ["{EXACT_SELECTOR_OR_EXPANSION_TRIGGER}"]
    }
  ],
  "budget": {
    "max_words": 1,
    "selected_content_words": 0,
    "semantic_definition_words": 0,
    "total_words": 0
  },
  "receipt": {
    "schema_version": 1,
    "receipt_kind": "alatyr-context-receipt",
    "measurement_state": "{PLANNED_RESOLVED_OR_OBSERVED}",
    "planned": {
      "paths": [
        "{PLANNED_CONTEXT_PATH}"
      ],
      "approximate_words": "{COUNT_OR_UNKNOWN}"
    },
    "resolved": {
      "status": "{RECORDED_OR_UNAVAILABLE}",
      "paths": [
        "{RESOLVED_CONTEXT_PATH}"
      ],
      "approximate_words": "{COUNT_OR_UNKNOWN}"
    },
    "observed": {
      "evidence_level": "{EXACT_PARTIAL_OR_UNAVAILABLE}",
      "source": "{HOST_TELEMETRY_PROVIDER_USAGE_ASSISTANT_REPORTED_MANUAL_OR_UNAVAILABLE}",
      "files_loaded": "{COUNT_OR_UNKNOWN}",
      "input_tokens": "{COUNT_OR_UNKNOWN}",
      "cached_input_tokens": "{COUNT_OR_UNKNOWN}",
      "output_tokens": "{COUNT_OR_UNKNOWN}",
      "evidence": "{EVIDENCE_REFERENCE_OR_UNAVAILABLE}"
    },
    "semantic_guidance": {
      "schema_version": 1,
      "planned": "{RECORDED_IDENTITIES_AND_BUNDLE_DIGEST_OR_UNAVAILABLE}",
      "resolved": "{RECORDED_IDENTITIES_AND_BUNDLE_DIGEST_OR_UNAVAILABLE}",
      "observed": "{EXACT_PARTIAL_OR_UNAVAILABLE_SEMANTIC_DELIVERY_EVIDENCE}"
    },
    "task_classification": {
      "class": "{SMALL_TASK_STANDARD_TASK_LARGE_OR_RESUMABLE_PROTECTED_OR_SENSITIVE_OR_UNRESOLVED}",
      "selected_task_scale_overlay": "{SMALL_TASK_OR_LARGE_OR_RESUMABLE_OR_OTHER_OR_NONE}",
      "reason": "{CLASSIFICATION_REASON}",
      "expansion_triggers": [
        "{NONE_OR_TRIGGER}"
      ]
    }
  },
  "cost_claim": {
    "classification": "{STATIC_ESTIMATE_PROVIDER_USAGE_HOST_TELEMETRY_MANUAL_OR_UNAVAILABLE}",
    "exact_billing_claim": false,
    "exact_context_delivery_claim": false,
    "basis": "{STATIC_ROUTER_MEASUREMENT_HOST_USAGE_RECEIPT_PROVIDER_USAGE_MANUAL_REVIEW_OR_UNAVAILABLE}",
    "limitation": "{HIDDEN_CLIENT_CONTEXT_AND_BILLING_LIMITATION}"
  },
  "limitations": [
    "Static source estimates are not billed tokens.",
    "Provider usage alone does not prove exact semantic guidance delivery.",
    "Hidden client context may exist outside repository-visible evidence."
  ],
  "packet_digest": "sha256:{PACKET_DIGEST}"
}
