    },
    "project_map": {
      "path": ".ai/README.md",
      "sha256": "ad50958d5b2bfe641923394908c0ff08580e2e02fb8f3b320d64089dc51bc83f"
    },
    "context_router": {
      "path": ".ai/assistant/context-router.json",
