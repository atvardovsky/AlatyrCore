{
  "schema_version": 2,
  "index_kind": "target-bootstrap-index",
  "integrity": {
    "path": ".ai/assistant/bootstrap-integrity.json",
    "on_failure": "load integrity evidence and canonical sources; do not trust compact routing"
  },
  "installation": {
    "framework_version": "{ALATYR_CORE_VERSION}",
    "adapter_schema_version": "{ALATYR_ADAPTER_SCHEMA_VERSION}",
    "template_version": "{ALATYR_TEMPLATE_VERSION}",
    "support_profile": "{KERNEL_CORE_STANDARD_OR_FULL}",
    "framework_pack": "{KERNEL_CORE_STANDARD_OR_COMPLETE}"
  },
  "project_map": ".ai/README.md",
  "context_router": ".ai/assistant/context-router.json",
  "recursive_context": {
    "contour_indexes": {
      "framework": ".ai/framework/context-index.json",
      "project": ".ai/project/context-index.json",
      "assistant": ".ai/assistant/context-index.json"
    },
    "max_depth": 8,
    "on_failure": "load named canonical owner; report index drift; no complete contour fallback"
  },
  "semantic_preload": {
    "index": ".ai/framework/semantics/index.json",
    "codebook_schema_version": 2,
    "terms": [
      {
        "id": "alatyr:current-scope-authorization@1",
        "version": 1,
        "definition": "Inspect, modify, commit, publish, and live-external actions are separate authorization phases for the current logical task. A completed, redirected, ambiguous, discussion-only, or analysis-only request does not authorize a later state-changing phase.",
        "owner_rule_id": "ALATYR-AUTHORIZATION-001",
        "canonical_owner": ".ai/framework/action-authorization.md"
      },
      {
        "id": "alatyr:canonical-owner@1",
        "version": 1,
        "definition": "Use the target-registered canonical owner for a fact type, preserve its conflict resolver and synchronization direction, and treat routing records, summaries, evidence, frequency, and recency as non-authoritative unless that owner says otherwise.",
        "owner_rule_id": "ALATYR-SOURCE-001",
        "canonical_owner": ".ai/framework/source-of-truth-registry.md"
      },
      {
        "id": "alatyr:risk-by-fact@1",
        "version": 1,
        "definition": "Classify risk from changed facts, affected boundaries, reversibility, external effects, and target policy rather than from file count or apparent patch size; expand to the applicable owner, approval, safety, and validation evidence before acting.",
        "owner_rule_id": "ALATYR-RISK-001",
        "canonical_owner": ".ai/framework/change-risk-model.md"
      },
      {
        "id": "alatyr:protected-change@1",
        "version": 1,
        "definition": "A change that crosses a target-recorded protected category requires a current scoped approval whose semantic and path surfaces cover the actual change; changing the plan or scope invalidates approval as defined by the target policy.",
        "owner_rule_id": "ALATYR-APPROVAL-001",
        "canonical_owner": ".ai/framework/approval-records.md"
      },
      {
        "id": "alatyr:logical-integrity@1",
        "version": 1,
        "definition": "Name changed semantic facts, re-derive their invariants, identify canonical owners and directly dependent surfaces, reconcile related findings as one repair set, validate the result, and report unresolved relationships and residual risk.",
        "owner_rule_id": "ALATYR-INTEGRITY-001",
        "canonical_owner": ".ai/framework/logical-integrity.md"
      },
      {
        "id": "alatyr:bounded-context-expansion@1",
        "version": 1,
        "definition": "Start from the smallest matching profile and selected index branch. Expand only for an applicable owner, safety or approval boundary, named dependency, changed-fact relationship, conflict, failed validation, or explicit broader audit, and record why the expansion occurred.",
        "owner_rule_id": "ALATYR-CONTEXT-001",
        "canonical_owner": ".ai/framework/context-profiles.md"
      }
    ],
    "fallback": "load referenced canonical owner; report missing stale conflicting cyclic or unsupported term"
  },
  "rule_selector": ".ai/framework/rule-registry.json",
  "context_packet": {
    "schema_version": 3,
    "template": ".ai/assistant/templates/context-packet.json",
    "receipt_required_for": [
      "budget exceeded",
      "multiple project areas",
      "cross-boundary work",
      "semantic codebook fallback",
      "material or protected change",
      "token or cost claim"
    ]
  },
  "recovery_entry_packet": ".ai/assistant/entry-packet.json",
  "routing_order": [
    "docs-local",
    "code-local",
    "business-change",
    "architecture-change",
    "data-change",
    "security-sensitive",
    "ai-infrastructure",
    "framework-upgrade"
  ],
  "profiles": {
    "docs-local": {
      "selector": "docs-local",
      "descriptor": ".ai/assistant/context/profiles/docs-local.json"
    },
    "code-local": {
      "selector": "code-local",
      "descriptor": ".ai/assistant/context/profiles/code-local.json"
    },
    "business-change": {
      "selector": "business-change",
      "descriptor": ".ai/assistant/context/profiles/business-change.json"
    },
    "architecture-change": {
      "selector": "architecture-change",
      "descriptor": ".ai/assistant/context/profiles/architecture-change.json"
    },
    "data-change": {
      "selector": "data-change",
      "descriptor": ".ai/assistant/context/profiles/data-change.json"
    },
    "security-sensitive": {
      "selector": "security-sensitive",
      "descriptor": ".ai/assistant/context/profiles/security-sensitive.json"
    },
    "ai-infrastructure": {
      "selector": "ai-infrastructure",
      "descriptor": ".ai/assistant/context/profiles/ai-infrastructure.json"
    },
    "framework-upgrade": {
      "selector": "framework-upgrade",
      "descriptor": ".ai/assistant/context/profiles/framework-upgrade.json"
    }
  },
  "intent_index": ".ai/assistant/context/intents/context-index.json",
  "task_scale_overlays": {
    "small-task": {
      "selector": "small-task",
      "descriptor": ".ai/assistant/context/task-scales/small-task.json"
    },
    "large-or-resumable": {
      "selector": "large-or-resumable",
      "descriptor": ".ai/assistant/context/task-scales/large-or-resumable.json",
      "required_module": "large-task-orchestration"
    },
    "delegated-execution": {
      "selector": "delegated-execution",
      "descriptor": ".ai/assistant/context/task-scales/delegated-execution.json",
      "required_module": "subagent-delegation"
    },
    "change-package": {
      "selector": "change-package",
      "descriptor": ".ai/assistant/context/task-scales/change-package.json",
      "required_module": "change-packages"
    },
    "engineering-evidence": {
      "selector": "engineering-evidence",
      "descriptor": ".ai/assistant/context/task-scales/engineering-evidence.json"
    },
    "debug-mode": {
      "selector": "debug-mode",
      "descriptor": ".ai/assistant/context/task-scales/debug-mode.json",
      "required_module": "debug-mode"
    },
    "team-active": {
      "selector": "team-active",
      "descriptor": ".ai/assistant/team/context-overlay.json",
      "required_module": "team-collaboration"
    }
  },
  "task_classification": {
    "order": [
      "protected-or-sensitive",
      "large-or-resumable",
      "small-task",
      "standard-task"
    ],
    "default": "standard-task",
    "ambiguity": "inspect-only"
  },
  "area_overlays": {
    "{TARGET_AREA_ID}": {
      "selector": "{TARGET_AREA_ID}"
    }
  },
  "project_knowledge_routing": ".ai/assistant/context/project-knowledge-routing.json",
  "operation_index": ".ai/assistant/operation-index.json",
  "operation_catalog": ".ai/assistant/operation-catalog.json",
  "gate_index": ".ai/assistant/gates/index.json",
  "enabled_modules": [],
  "known_gaps": [
    "{KNOWN_GAP}"
  ],
  "expansion_policy": "load required safety and owner evidence; record expansion reason, measured context, and omissions"
}
