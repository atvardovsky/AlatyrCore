{
  "schema_version": 1,
  "policy_kind": "target-subagent-delegation-policy",
  "state": "{ENABLED_SUGGEST_ONLY_DISABLED_OR_BLOCKED}",
  "owner": "{TARGET_DELEGATION_POLICY_OWNER}",
  "decision_mode": "{AUTOMATIC_SUGGEST_ONLY_OR_DISABLED}",
  "default_preference": "{AUTO_ALLOW_FORBID_OR_REQUIRE_SUPPORTED}",
  "max_parallel_delegates": "{POSITIVE_INTEGER_OR_TARGET_LIMIT}",
  "requirements": {
    "primary_keeps_critical_path": true,
    "independent_local_acceptance": true,
    "disjoint_write_scope": true,
    "primary_final_convergence": true,
    "current_capability_evidence": true
  },
  "eligible_work": [
    "{TARGET_BOUNDED_ELIGIBLE_WORK_CLASS}"
  ],
  "prohibited_work": [
    "unresolved business rules or semantic invariants",
    "architecture or source-of-truth decisions",
    "approval or decision authority",
    "security permissions credentials destructive production spend migration or external-effect work",
    "overlapping write scopes or final convergence",
    "{TARGET_ADDITIONAL_PROHIBITED_WORK}"
  ],
  "roles": [
    {
      "id": "fast-focused-worker",
      "state": "{ENABLED_DISABLED_OR_BLOCKED}",
      "use_when": [
        "small focused reversible context-bounded work",
        "objective local validation exists",
        "{TARGET_FAST_WORKER_TRIGGER}"
      ],
      "allowed_actions": [
        "{READ_ONLY_DOCS_ONLY_ADAPTER_ONLY_OR_CODE_AND_TESTS}"
      ],
      "allowed_tools": [
        "{TARGET_ALLOWED_TOOL_OR_NONE}"
      ],
      "max_files": "{POSITIVE_INTEGER_OR_TARGET_LIMIT}",
      "max_context_words": "{POSITIVE_INTEGER_OR_TARGET_LIMIT}",
      "model_binding": {
        "assistant_surface": "{SUPPORTED_ASSISTANT_SURFACE}",
        "selection_mode": "{EXPLICIT_MODEL_INHERIT_OR_CLIENT_DEFAULT}",
        "model": "{VERIFIED_MODEL_ID_OR_INHERIT}",
        "availability": "{SUPPORTED_UNSUPPORTED_OR_UNKNOWN}",
        "verified_at": "{ISO_DATE_OR_UNKNOWN_WITH_REASON}",
        "client_version": "{CLIENT_VERSION_OR_UNKNOWN_WITH_REASON}",
        "evidence": "{TARGET_CAPABILITY_EVIDENCE_OR_MANUAL_REVIEW}",
        "expires_at": "{ISO_DATE_OR_REVIEW_TRIGGER_WITH_REASON}"
      },
      "required_validation": [
        "{TARGET_ROLE_VALIDATION_OR_MANUAL_REVIEW}"
      ],
      "fallback": "{CONTINUE_PRIMARY_USE_STRONGER_VERIFIED_MODEL_OR_STOP}"
    }
  ],
  "result_policy": {
    "accept_out_of_scope_changes": false,
    "accept_unvalidated_changes": false,
    "require_primary_review": true,
    "require_actual_model_or_unverified_status": true
  },
  "privacy_and_retention": "{TARGET_PACKET_AND_RESULT_PRIVACY_RETENTION_POLICY}",
  "validation": [
    "{TARGET_DELEGATION_POLICY_VALIDATION_OR_MANUAL_REVIEW}"
  ],
  "review_triggers": [
    "assistant client or model availability changed",
    "tool permission or write-isolation behavior changed",
    "delegated work caused rework validation failure or scope drift",
    "{TARGET_DELEGATION_POLICY_REVIEW_TRIGGER}"
  ]
}
