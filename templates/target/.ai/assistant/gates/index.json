{
  "schema_version": 1,
  "index_kind": "target-gate-index",
  "canonical_full_checklist": ".ai/assistant/gates/checklist.md",
  "gates": {
    "core": {
      "path": ".ai/assistant/gates/core.md",
      "use_when": ["every state-changing task"]
    },
    "documentation": {
      "path": ".ai/assistant/gates/documentation.md",
      "use_when": ["documentation or public explanation changes"]
    },
    "code-and-tests": {
      "path": ".ai/assistant/gates/code-and-tests.md",
      "use_when": ["implementation or test changes"]
    },
    "semantic-integrity": {
      "path": ".ai/assistant/gates/semantic-integrity.md",
      "use_when": ["semantic fact or accepted contract may change"]
    },
    "security-approval": {
      "path": ".ai/assistant/gates/security-approval.md",
      "use_when": ["protected security live destructive permission dependency or approval boundary"]
    },
    "dependency-knowledge": {
      "path": ".ai/assistant/gates/dependency-knowledge.md",
      "use_when": ["dependency knowledge is discovered synchronized explained or used for impact analysis"]
    },
    "workspace-mode": {
      "path": ".ai/assistant/gates/workspace-mode.md",
      "use_when": ["workspace mode is suggested selected accepted changed disabled deprecated removed or used for state-changing work"]
    },
    "engineering-evidence": {
      "path": ".ai/assistant/gates/engineering-evidence.md",
      "use_when": ["material semantic architectural or non-obvious repair reaches finalization"]
    },
    "final-evidence": {
      "path": ".ai/assistant/gates/final-evidence.md",
      "use_when": ["before reporting completion"]
    }
  },
  "profile_defaults": {
    "docs-local": ["core", "documentation", "final-evidence"],
    "code-local": ["core", "code-and-tests", "final-evidence"],
    "business-change": ["core", "semantic-integrity", "final-evidence"],
    "architecture-change": ["core", "semantic-integrity", "final-evidence"],
    "data-change": ["core", "semantic-integrity", "code-and-tests", "final-evidence"],
    "security-sensitive": ["core", "semantic-integrity", "security-approval", "final-evidence"],
    "ai-infrastructure": ["core", "final-evidence"],
    "framework-upgrade": ["core", "final-evidence"]
  }
}
