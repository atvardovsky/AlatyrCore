{
  "schema_version": 1,
  "descriptor_kind": "target-context-profile",
  "profile": "framework-upgrade",
  "use_when": [
    "installing Alatyr",
    "updating Alatyr Core",
    "adapter recheck",
    "adapter maturity review",
    "framework drift repair"
  ],
  "operation_candidates": [
    "adapter-health",
    "recheck-after-framework-update",
    "recheck-after-installation",
    "adapter-maturity-review",
    "extension-management",
    "support-generation"
  ],
  "required_context": [
    ".ai/assistant/context/migration-routing.json",
    "{TARGET_UPGRADE_IMPACT_REPORT}",
    ".ai/assistant/gates/core.md",
    ".ai/assistant/gates/final-evidence.md"
  ],
  "conditional_context": [
    {"path": ".ai/framework/action-authorization.md", "when": "authorization phase semantics are disputed or the target policy requires repair"},
    {"path": ".ai/framework/lifecycle.md", "when": "the impact report selects lifecycle or target migration actions"},
    {"path": ".ai/framework/migration-diff.md", "when": "migration evidence must be generated repaired or interpreted"},
    {"path": ".ai/framework/support-information.md", "when": "support policy state impact or generation contracts changed"},
    {"path": ".ai/framework/rule-registry.json", "when": "changed rule IDs need canonical detail or the impact report is disputed"},
    {"path": ".ai/assistant/flows/adapter-recheck.flow.md", "when": "the reviewed assessment enters apply or post-update validation"},
    {"path": ".ai/assistant/templates/installation-note.md", "when": "installation baseline or current adapter state must be inspected or updated"},
    {"path": ".ai/assistant/templates/migration-note.md", "when": "reviewed migration impact must be recorded for the target"},
    {"path": ".ai/assistant/gates/security-approval.md", "when": "the update would overwrite instructions or change protected adapter behavior"}
  ],
  "expand_when": [
    "migration_assessment_identifies_affected_canonical_source",
    "changed_target_template_surface",
    "protected_adapter_overwrite",
    "bridge_capability_change",
    "target_local_deviation_conflict",
    "validation_disproves_impact_boundary"
  ],
  "approval_gates": [
    "overwriting_existing_instructions",
    "protected_adapter_behavior_change",
    "third_party_assistant_infrastructure_adoption"
  ],
  "validation": [
    "{TARGET_ADAPTER_RECHECK_OR_MANUAL_REVIEW}"
  ],
  "final_evidence": [
    "adapter_version_schema_state",
    "changed_framework_baseline",
    "migration_assessment",
    "selected_and_omitted_canonical_sources",
    "affected_target_files",
    "gaps",
    "local_deviations",
    "validation",
    "migration_actions"
  ]
}
