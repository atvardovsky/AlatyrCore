{
  "schema_version": 3,
  "map_kind": "target-consistency-map",
  "human_registry": ".ai/project/source-of-truth-registry.md",
  "registry_sync_policy": {
    "coverage": "every-live-registry-fact-type",
    "node_reference": "registry-consistency-map-node-id",
    "fact_type_match": "exact",
    "extra_nodes": "allowed-for-derived-contract-area-system-adapter-and-surface-nodes"
  },
  "levels": [
    "fact",
    "contract",
    "area",
    "system",
    "adapter",
    "surface"
  ],
  "relationship_types": [
    "implements",
    "verifies",
    "documents",
    "visualizes",
    "generates",
    "constrains",
    "depends-on",
    "routes"
  ],
  "relationship_states": [
    "observed",
    "proposed",
    "accepted",
    "rejected",
    "stale",
    "contradicted",
    "removed"
  ],
  "impact_policy": {
    "default_mode": "owner-and-applicable-accepted-relationships",
    "max_depth": 4,
    "max_nodes": 100,
    "transitive_expand_when": [
      "dependent fact or contract can change",
      "cross-area contract changes",
      "owner or relationship evidence conflicts",
      "validation disproves the current boundary",
      "approval trigger is reached"
    ],
    "required_evidence": [
      "changed fact IDs and canonical owners",
      "selected and skipped accepted edges",
      "levels areas and concrete surfaces reached",
      "unmapped changes and relationship candidates",
      "validation approvals and residual risk"
    ]
  },
  "node_shards": [
    {
      "id": "{TARGET_PROJECT_AREA_ID}",
      "path": ".ai/project/consistency/areas/_template.json"
    }
  ],
  "reverse_index": ".ai/assistant/consistency-reverse-index.json",
  "relationship_candidates": ".ai/project/consistency/relationship-candidates.json"
}
