  "human_index": ".ai/project/documentation/README.md",
  "profiles": ".ai/project/documentation/profiles.json",
  "documentation_owner": "{TARGET_CODE_DOCUMENTATION_OWNER}",
  "profile_decision_authority": "{TARGET_DOCUMENTATION_PROFILE_DECISION_AUTHORITY}",
