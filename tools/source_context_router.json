{
  "schema_version": 1,
  "router_kind": "alatyr-source-context-router",
  "canonical_rule": "ALATYR-CONTEXT-001",
  "preloaded_context": ["AGENTS.md"],
  "bootstrap_context": [
    "tools/source_context_router.json"
  ],
  "recursive_context": {
    "schema_version": 1,
    "framework_index": "framework/context-index.json",
    "max_depth": 8,
    "selection": "follow only entries matched by the selected profile, rule owner, path, contract, dependency, risk, conflict, or failed check"
  },
  "semantic_codebook": {
    "schema_version": 2,
    "index": "framework/semantics/index.json",
    "load_mode": "lazy-before-first-compact-semantic-reference",
    "preload_terms": [
      "alatyr:current-scope-authorization@1",
      "alatyr:canonical-owner@1",
      "alatyr:risk-by-fact@1",
      "alatyr:protected-change@1",
      "alatyr:logical-integrity@1",
      "alatyr:bounded-context-expansion@1"
    ],
    "fallback": "load canonical owner prose and stop compact interpretation"
  },
  "budgets": {
    "bootstrap_max_words": 2500,
    "minimum_headroom_words": 100,
    "on_exceed": "stop and repair or report routing drift"
  },
  "rule_dependency_loading": {
    "default": "conditional-reference",
    "meaning": "alatyr_doc depends_on identifies a reasoning prerequisite, not automatic whole-document preload",
    "select_when": "the chosen rule decision depends on the prerequisite, evidence conflicts, or a named boundary is crossed",
    "packet_evidence": "record selected and omitted dependency rule IDs with reasons",
    "fail_closed": "load the selected dependency owner when applicability cannot be decided from compact metadata"
  },
  "task_classification": {
    "schema_version": 1,
    "classification_order": [
      "protected-or-sensitive",
      "large-or-resumable",
      "small-task",
      "standard-task"
    ],
    "default_class": "standard-task",
    "ambiguity_behavior": "stay read-only; choose the smallest plausible profile; request missing facts before edits",
    "small_task_eligibility": {
      "default_enabled": false,
      "maximum_changed_paths": 1,
      "profiles": {
        "docs-local": {
          "allowed_path_patterns": ["README.md", "docs/**"]
        },
        "source-tooling": {
          "allowed_path_patterns": ["tools/**", "tests/**"]
        }
      },
      "boundary_path_patterns": [
        "AGENTS.md",
        "AI_ASSISTANTS.md",
        "INSTALL.md",
        "CHANGELOG.md",
        "VERSION",
        "ADAPTER_SCHEMA_VERSION",
        "TEMPLATE_VERSION",
        "framework/**",
        "installer/**",
        "templates/**",
        ".github/**",
        "tools/check_manifest.json",
        "tools/source_context_router.json",
        "tools/source_worker_policy.json"
      ],
      "requires_no_unmatched_paths": true,
      "requires_no_full_fallback": true,
      "requires_focused_check_coverage": true
    },
    "small_task_use_when": [
      "one source profile",
      "one local file",
      "no protected boundaries",
      "focused source checks prove the result"
    ],
    "expansion_triggers": [
      "framework rule or lifecycle behavior changes",
      "adapter schema or target template contract changes",
      "source-of-truth conflict or ownership ambiguity",
      "approval, authorization, safety, security, release, or assistant-infrastructure boundary appears",
      "focused validation fails or selected check coverage is ambiguous",
      "explicit repository audit, release readiness review, or full corpus comparison"
    ]
  },
  "conditional_overlays": {
    "source-worker-strategy": {
      "activate_when": "profile-required or beneficial bounded delegation",
      "required_context": ["docs/source-worker-strategy.md"],
      "worker_policy": "tools/source_worker_policy.json",
      "canonical_rule": "ALATYR-DELEGATION-001",
      "runtime_capability_owner": "active-assistant",
      "skip_evidence": "required for eligible local work",
      "fallback": "continue with the primary assistant"
    }
  },
  "profiles": {
    "docs-local": {
      "required_context": [],
      "conditional_context": [
        {"id": "docs-edited-path", "resolver": "path-pattern", "path_or_registry_query": "docs/**", "when": "a documentation path is edited"},
        {"id": "docs-root-readme", "resolver": "exact-path", "path_or_registry_query": "README.md", "when": "the repository README is edited"},
        {"id": "docs-linked-neighbor", "resolver": "selector-paths", "path_or_registry_query": "linked_paths", "when": "a direct local link can change with the edited document"},
        {"id": "docs-maintenance-section", "resolver": "indexed-query", "path_or_registry_query": "docs/framework-maintenance.md#selector=acceptance_or_lifecycle_topics", "when": "acceptance or lifecycle routing is ambiguous"}
      ],
      "context_budget": {
        "max_required_files": 0,
        "max_required_words": 0,
        "max_initial_words": 2500,
        "max_resolved_files": 8,
        "max_resolved_words": 14000,
        "max_resolved_characters": 130000,
        "reserved_files": 2,
        "reserved_words": 1500,
        "reserved_characters": 12000
      },
      "check_profile": "fast",
      "checks": ["markdown-links", "framework-consistency"]
    },
    "framework-rule": {
      "required_context": [
        "framework/context-index.json",
        "framework/semantics/index.json"
      ],
      "conditional_context": [
        {"id": "framework-rule-registry-entry", "resolver": "indexed-query", "path_or_registry_query": "framework/rule-registry.json#selector=rule_ids", "when": "an exact changed rule ID is known"},
        {"id": "framework-canonical-owner", "resolver": "indexed-query", "path_or_registry_query": "framework/context-index.json#selector=rule_ids", "when": "a rule decision requires its canonical owner", "owner_rule_id": "$rule_id"},
        {"id": "framework-dependency-owner", "resolver": "indexed-query", "path_or_registry_query": "framework/context-index.json#selector=dependency_rule_ids", "when": "the selected rule depends on a prerequisite", "owner_rule_id": "$dependency_rule_id"},
        {"id": "framework-installer-surface", "resolver": "path-pattern", "path_or_registry_query": "installer/**", "when": "a changed rule affects installer behavior"},
        {"id": "framework-target-template-surface", "resolver": "path-pattern", "path_or_registry_query": "templates/target/**", "when": "a changed rule affects an installed target surface"}
      ],
      "context_budget": {
        "max_required_files": 2,
        "max_required_words": 700,
        "max_initial_words": 2900,
        "max_resolved_files": 10,
        "max_resolved_words": 18000,
        "max_resolved_characters": 175000,
        "reserved_files": 2,
        "reserved_words": 1500,
        "reserved_characters": 12000
      },
      "check_profile": "fast",
      "checks": ["framework-metadata", "rule-ownership", "framework-consistency"]
    },
    "installer-template": {
      "required_context": [
        "installer/context-router.json"
      ],
      "conditional_context": [
        {"id": "installer-stage-context", "resolver": "indexed-query", "path_or_registry_query": "installer/context-router.json#selector=installer_stage_ids", "when": "one or more installer stages are in scope"},
        {"id": "installer-public-contract", "resolver": "exact-path", "path_or_registry_query": "INSTALL.md", "when": "public installation behavior is affected"},
        {"id": "installer-execution-flow", "resolver": "exact-path", "path_or_registry_query": "installer/assistant-installation.flow.md", "when": "assistant execution behavior is affected"},
        {"id": "installer-readiness-or-plan", "resolver": "selector-paths", "path_or_registry_query": "readiness_or_plan_paths", "when": "a readiness or installation-plan surface is affected"},
        {"id": "installer-target-template", "resolver": "path-pattern", "path_or_registry_query": "templates/target/**", "when": "an installed target projection is affected"},
        {"id": "installer-rule-owner", "resolver": "indexed-query", "path_or_registry_query": "framework/context-index.json#selector=rule_ids", "when": "installer behavior depends on a portable rule", "owner_rule_id": "$rule_id"}
      ],
      "context_budget": {
        "max_required_files": 1,
        "max_required_words": 900,
        "max_initial_words": 3400,
        "max_resolved_files": 10,
        "max_resolved_words": 20000,
        "max_resolved_characters": 180000,
        "reserved_files": 2,
        "reserved_words": 1600,
        "reserved_characters": 14000
      },
      "check_profile": "fast",
      "checks": ["source-context-routing", "scaffold-profiles", "framework-consistency"]
    },
    "source-tooling": {
      "required_context": [],
      "conditional_context": [
        {"id": "source-tool-changed-path", "resolver": "path-pattern", "path_or_registry_query": "tools/**", "when": "a source tool path is changed"},
        {"id": "source-test-changed-path", "resolver": "path-pattern", "path_or_registry_query": "tests/**", "when": "a source tool test path is changed"},
        {"id": "source-tool-contract", "resolver": "selector-paths", "path_or_registry_query": "contract_paths", "when": "the tool validates a named contract surface"},
        {"id": "source-check-manifest-entry", "resolver": "indexed-query", "path_or_registry_query": "tools/check_manifest.json#selector=check_ids", "when": "one or more exact source check IDs are selected"},
        {"id": "source-architecture-section", "resolver": "indexed-query", "path_or_registry_query": "docs/source-architecture.md#selector=architecture_topics", "when": "the affected component has source architecture guidance"},
        {"id": "source-cli-section", "resolver": "indexed-query", "path_or_registry_query": "tools/README.md#selector=cli_topics", "when": "the tool command or public CLI usage changes"},
        {"id": "source-maintenance-fallback", "resolver": "indexed-query", "path_or_registry_query": "docs/framework-maintenance.md#selector=acceptance_or_lifecycle_topics", "when": "acceptance or lifecycle routing is ambiguous"}
      ],
      "context_budget": {
        "max_required_files": 0,
        "max_required_words": 0,
        "max_initial_words": 2500,
        "max_resolved_files": 10,
        "max_resolved_words": 24000,
        "max_resolved_characters": 300000,
        "reserved_files": 2,
        "reserved_words": 1600,
        "reserved_characters": 14000
      },
      "check_profile": "fast",
      "check_selection": "select fast changed-path checks by trigger_paths",
      "checks": ["check-manifest", "support-costs", "source-unit-tests", "framework-consistency"]
    },
    "release-versioning": {
      "required_context": [
        "VERSION",
        "ADAPTER_SCHEMA_VERSION",
        "TEMPLATE_VERSION",
        "docs/release-process.md"
      ],
      "conditional_context": [
        {"id": "release-lifecycle-section", "resolver": "indexed-query", "path_or_registry_query": "framework/lifecycle.md#selector=lifecycle_phases", "when": "a release lifecycle phase is selected", "owner_rule_id": "ALATYR-LIFECYCLE-001"},
        {"id": "release-migration-contract", "resolver": "exact-path", "path_or_registry_query": "framework/migration-diff.md", "when": "a migration or compatibility boundary applies", "owner_rule_id": "ALATYR-LIFECYCLE-001"},
        {"id": "release-changelog-section", "resolver": "indexed-query", "path_or_registry_query": "CHANGELOG.md#selector=changelog_sections", "when": "the Unreleased or latest-version record is in scope"},
        {"id": "release-migration-report", "resolver": "selector-paths", "path_or_registry_query": "release_report_paths", "when": "a concrete migration report is part of the release"},
        {"id": "release-rule-owner", "resolver": "indexed-query", "path_or_registry_query": "framework/context-index.json#selector=rule_ids", "when": "changed release behavior is owned by a portable rule", "owner_rule_id": "$rule_id"},
        {"id": "release-target-template", "resolver": "path-pattern", "path_or_registry_query": "templates/target/**", "when": "the release changes an installed target projection"}
      ],
      "context_budget": {
        "max_required_files": 4,
        "max_required_words": 1200,
        "max_initial_words": 3400,
        "max_resolved_files": 14,
        "max_resolved_words": 30000,
        "max_resolved_characters": 250000,
        "reserved_files": 2,
        "reserved_words": 2000,
        "reserved_characters": 16000
      },
      "check_profile": "full",
      "additional_check_profiles": ["release"],
      "checks": ["versioning", "release-drift-release", "migration-diff-report"]
    },
    "ai-infrastructure-bridge": {
      "required_context": [
        "conformance/runs/assistant-surfaces.json",
        "templates/target/.ai/assistant/assistant-capabilities.json"
      ],
      "conditional_context": [
        {"id": "assistant-source-entry", "resolver": "indexed-query", "path_or_registry_query": "AI_ASSISTANTS.md#selector=assistant_surface_ids", "when": "source entry behavior changes for an assistant surface", "owner_rule_id": "ALATYR-BRIDGE-001"},
        {"id": "assistant-capability-record", "resolver": "selector-paths", "path_or_registry_query": "assistant_surface_paths", "when": "an assistant compatibility or capability record is selected", "owner_rule_id": "ALATYR-BRIDGE-001"},
        {"id": "ai-infrastructure-routing-owner", "resolver": "exact-path", "path_or_registry_query": "framework/ai-infrastructure-routing.md", "when": "AI infrastructure item routing changes", "owner_rule_id": "ALATYR-BRIDGE-001"},
        {"id": "ai-infrastructure-item", "resolver": "selector-paths", "path_or_registry_query": "ai_infrastructure_item_paths", "when": "a skill prompt gate tool MCP bridge or wrapper is selected"},
        {"id": "assistant-admission-contract", "resolver": "selector-paths", "path_or_registry_query": "assistant_admission_paths", "when": "assistant support or capability admission changes", "owner_rule_id": "ALATYR-BRIDGE-001"},
        {"id": "ai-import-policy", "resolver": "indexed-query", "path_or_registry_query": "framework/prompt-injection.md#selector=external_source_ids", "when": "an external AI infrastructure source is involved", "owner_rule_id": "ALATYR-SAFETY-002"},
        {"id": "ai-operation-help", "resolver": "exact-path", "path_or_registry_query": "framework/operation-help.md", "when": "installed operation routing changes", "owner_rule_id": "ALATYR-OPERATION-001"}
      ],
      "context_budget": {
        "max_required_files": 2,
        "max_required_words": 600,
        "max_initial_words": 2800,
        "max_resolved_files": 16,
        "max_resolved_words": 16000,
        "max_resolved_characters": 140000,
        "reserved_files": 3,
        "reserved_words": 2500,
        "reserved_characters": 20000
      },
      "check_profile": "full",
      "checks": [
        "assistant-surface-conformance",
        "assistant-capability-contract",
        "assistant-surface-audits",
        "bridge-capability-matrix"
      ]
    },
    "repository-audit": {
      "required_context": [
        "docs/source-worker-strategy.md",
        "tools/source_worker_policy.json"
      ],
      "conditional_context": [
        {"id": "audit-check-manifest-entries", "resolver": "indexed-query", "path_or_registry_query": "tools/check_manifest.json#selector=audit_check_ids", "when": "audit workstreams or failed checks identify exact check IDs"},
        {"id": "audit-maintenance-section", "resolver": "indexed-query", "path_or_registry_query": "docs/framework-maintenance.md#selector=acceptance_topics", "when": "the audit evaluates acceptance behavior"},
        {"id": "audit-source-architecture-section", "resolver": "indexed-query", "path_or_registry_query": "docs/source-architecture.md#selector=architecture_topics", "when": "the audit evaluates a named source component"},
        {"id": "audit-workstream-context", "resolver": "selector-paths", "path_or_registry_query": "audit_context_paths", "when": "selected workstreams declare bounded context"},
        {"id": "audit-failed-check-owner", "resolver": "indexed-query", "path_or_registry_query": "framework/context-index.json#selector=failed_owner_rule_ids", "when": "failed checks identify canonical owner rule IDs", "owner_rule_id": "$failed_owner_rule_id"},
        {"id": "audit-installer-surface", "resolver": "path-pattern", "path_or_registry_query": "installer/**", "when": "audit evidence reaches installer behavior"},
        {"id": "audit-target-template-surface", "resolver": "path-pattern", "path_or_registry_query": "templates/target/**", "when": "audit evidence reaches target projections"},
        {"id": "audit-release-context", "resolver": "indexed-query", "path_or_registry_query": "docs/release-process.md#selector=release_failure_ids", "when": "one or more release checks fail", "owner_rule_id": "ALATYR-LIFECYCLE-001"}
      ],
      "context_budget": {
        "max_required_files": 2,
        "max_required_words": 1950,
        "max_initial_words": 4400,
        "max_resolved_files": 18,
        "max_resolved_words": 30000,
        "max_resolved_characters": 350000,
        "reserved_files": 4,
        "reserved_words": 3500,
        "reserved_characters": 30000
      },
      "check_profile": "full",
      "decomposition": {
        "required": true,
        "worker_policy": "tools/source_worker_policy.json",
        "candidate_workstreams": [
          "framework-rules",
          "installation-surfaces",
          "source-tooling",
          "public-and-release"
        ]
      },
      "checks": ["check-manifest", "source-unit-tests", "framework-consistency"]
    }
  },
  "expansion_triggers": [
    "canonical owner dependency",
    "cross-contour change",
    "approval or safety boundary",
    "conflicting evidence",
    "failed focused check",
    "intentional full-corpus comparison or rebaseline"
  ],
  "fallback": "report an unmatched task; do not load the full framework automatically"
}
