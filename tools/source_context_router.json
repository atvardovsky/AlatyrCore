{
  "schema_version": 1,
  "router_kind": "alatyr-source-context-router",
  "canonical_rule": "ALATYR-CONTEXT-001",
  "preloaded_context": ["AGENTS.md"],
  "bootstrap_context": [
    "tools/source_context_router.json",
    "framework/semantics/core.json"
  ],
  "recursive_context": {
    "schema_version": 1,
    "framework_index": "framework/context-index.json",
    "max_depth": 8,
    "selection": "follow only entries matched by the selected profile, rule owner, path, contract, dependency, risk, conflict, or failed check"
  },
  "semantic_codebook": {
    "schema_version": 1,
    "index": "framework/semantics/index.json",
    "preload_terms": [
      "alatyr:current-scope-authorization@1",
      "alatyr:canonical-owner@1",
      "alatyr:protected-change@1",
      "alatyr:logical-integrity@1",
      "alatyr:bounded-context-expansion@1"
    ],
    "fallback": "load canonical owner prose and stop compact interpretation"
  },
  "budgets": {
    "bootstrap_max_words": 2100,
    "minimum_headroom_words": 100,
    "on_exceed": "stop and repair or report routing drift"
  },
  "task_classification": {
    "schema_version": 1,
    "classification_order": [
      "protected-or-sensitive",
      "large-or-resumable",
      "small-task",
      "standard-task"
    ],
    "default_class": "standard-task",
    "ambiguity_behavior": "stay read-only; choose the smallest plausible profile; request missing facts before edits",
    "small_task_eligibility": {
      "default_enabled": false,
      "maximum_changed_paths": 1,
      "profiles": {
        "docs-local": {
          "allowed_path_patterns": ["README.md", "docs/**"]
        },
        "source-tooling": {
          "allowed_path_patterns": ["tools/**", "tests/**"]
        }
      },
      "boundary_path_patterns": [
        "AGENTS.md",
        "AI_ASSISTANTS.md",
        "INSTALL.md",
        "CHANGELOG.md",
        "VERSION",
        "ADAPTER_SCHEMA_VERSION",
        "TEMPLATE_VERSION",
        "framework/**",
        "installer/**",
        "templates/**",
        ".github/**",
        "tools/check_manifest.json",
        "tools/source_context_router.json",
        "tools/source_worker_policy.json"
      ],
      "requires_no_unmatched_paths": true,
      "requires_no_full_fallback": true,
      "requires_focused_check_coverage": true
    },
    "small_task_use_when": [
      "one source profile",
      "one local file",
      "no protected boundaries",
      "focused source checks prove the result"
    ],
    "expansion_triggers": [
      "framework rule or lifecycle behavior changes",
      "adapter schema or target template contract changes",
      "source-of-truth conflict or ownership ambiguity",
      "approval, authorization, safety, security, release, or assistant-infrastructure boundary appears",
      "focused validation fails or selected check coverage is ambiguous",
      "explicit repository audit, release readiness review, or full corpus comparison"
    ]
  },
  "conditional_overlays": {
    "source-worker-strategy": {
      "activate_when": "profile-required or beneficial bounded delegation",
      "required_context": ["docs/source-worker-strategy.md"],
      "worker_policy": "tools/source_worker_policy.json",
      "canonical_rule": "ALATYR-DELEGATION-001",
      "runtime_capability_owner": "active-assistant",
      "skip_evidence": "required for eligible local work",
      "fallback": "continue with the primary assistant"
    }
  },
  "profiles": {
    "docs-local": {
      "required_context": ["docs/framework-maintenance.md"],
      "conditional_context": ["edited file", "directly linked neighbor"],
      "check_profile": "fast",
      "checks": ["markdown-links", "framework-consistency"]
    },
    "framework-rule": {
      "required_context": ["framework/context-index.json"],
      "conditional_context": [
        "canonical owner selected by rule ID",
        "owner dependency selected from alatyr_doc metadata",
        "affected installer or target template surface"
      ],
      "check_profile": "fast",
      "checks": ["framework-metadata", "rule-ownership", "framework-consistency"]
    },
    "installer-template": {
      "required_context": [
        "installer/context-router.json",
        "INSTALL.md",
        "installer/assistant-installation.flow.md"
      ],
      "conditional_context": [
        "affected readiness or plan section",
        "selected target template",
        "owning framework rule"
      ],
      "check_profile": "fast",
      "checks": ["source-context-routing", "scaffold-profiles", "framework-consistency"]
    },
    "source-tooling": {
      "required_context": [
        "tools/check_manifest.json",
        "docs/source-architecture.md"
      ],
      "conditional_context": [
        "tool being changed",
        "contract validated by the tool",
        "selected tools/README.md section for CLI usage",
        "docs/framework-maintenance.md for ambiguous acceptance or lifecycle routing"
      ],
      "check_profile": "fast",
      "check_selection": "select fast changed-path checks by trigger_paths",
      "checks": ["check-manifest", "support-costs", "source-unit-tests", "framework-consistency"]
    },
    "release-versioning": {
      "required_context": [
        "VERSION",
        "ADAPTER_SCHEMA_VERSION",
        "TEMPLATE_VERSION",
        "docs/release-process.md",
        "framework/lifecycle.md",
        "framework/migration-diff.md"
      ],
      "conditional_context": [
        "CHANGELOG.md Unreleased and latest version sections",
        "release migration report",
        "changed rule owners and templates"
      ],
      "check_profile": "full",
      "additional_check_profiles": ["release"],
      "checks": ["versioning", "release-drift-release", "migration-diff-report"]
    },
    "ai-infrastructure-bridge": {
      "required_context": [
        "AI_ASSISTANTS.md",
        "docs/assistant-compatibility.md",
        "framework/bridge-capability-matrix.md",
        "framework/ai-infrastructure-routing.md"
      ],
      "conditional_context": [
        "selected skill prompt gate tool MCP bridge or wrapper",
        "assistant surface admission audit and capability schema when support changes",
        "import policy when an external source is involved",
        "operation help when routing changes"
      ],
      "check_profile": "full",
      "checks": [
        "assistant-surface-conformance",
        "assistant-capability-contract",
        "assistant-surface-audits",
        "bridge-capability-matrix"
      ]
    },
    "repository-audit": {
      "required_context": [
        "tools/check_manifest.json",
        "docs/framework-maintenance.md",
        "docs/source-architecture.md",
        "docs/source-worker-strategy.md",
        "tools/source_worker_policy.json"
      ],
      "conditional_context": [
        "bounded context listed by each selected audit workstream",
        "canonical owners selected by failed check IDs",
        "affected installer or target template surfaces",
        "release context only when release checks fail"
      ],
      "check_profile": "full",
      "decomposition": {
        "required": true,
        "worker_policy": "tools/source_worker_policy.json",
        "candidate_workstreams": [
          "framework-rules",
          "installation-surfaces",
          "source-tooling",
          "public-and-release"
        ]
      },
      "checks": ["check-manifest", "source-unit-tests", "framework-consistency"]
    }
  },
  "expansion_triggers": [
    "canonical owner dependency",
    "cross-contour change",
    "approval or safety boundary",
    "conflicting evidence",
    "failed focused check",
    "intentional full-corpus comparison or rebaseline"
  ],
  "fallback": "report an unmatched task; do not load the full framework automatically"
}
