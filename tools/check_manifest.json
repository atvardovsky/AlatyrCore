{
  "schema_version": 1,
  "manifest_kind": "alatyr-source-checks",
  "defaults": {
    "profiles": ["full"],
    "platforms": ["all"],
    "write_scope": "none",
    "depends_on": []
  },
  "checks": [
    {"id": "framework-metadata", "command": ["tools/check_framework_metadata.py"], "profiles": ["fast", "full"], "owned_paths": ["framework/**", "tools/check_framework_metadata.py"]},
    {"id": "approval-template", "command": ["tools/check_approval_template.py"], "owned_paths": ["framework/approval-records.md", "templates/target/.ai/assistant/approvals/**", "tools/check_approval_template.py"]},
    {"id": "architecture-knowledge", "command": ["tools/check_architecture_knowledge.py"], "owned_paths": ["framework/architecture-knowledge.md", "templates/target/.ai/project/architecture/**", "tools/check_architecture_knowledge.py"]},
    {"id": "ai-infrastructure-inventory", "command": ["tools/check_ai_infrastructure_inventory.py"], "owned_paths": ["framework/ai-infrastructure-routing.md", "templates/target/.ai/assistant/**", "tools/check_ai_infrastructure_inventory.py"]},
    {"id": "ai-infrastructure-recommendations", "command": ["tools/check_ai_infrastructure_recommendations.py"], "owned_paths": ["framework/ai-infrastructure-routing.md", "templates/target/.ai/assistant/**", "tools/check_ai_infrastructure_recommendations.py"]},
    {"id": "ai-infrastructure-router", "command": ["tools/check_ai_infrastructure_router.py"], "owned_paths": ["framework/ai-infrastructure-routing.md", "templates/target/.ai/assistant/ai-infrastructure-router.json", "tools/check_ai_infrastructure_router.py"]},
    {"id": "assistant-surface-conformance", "command": ["tools/check_assistant_surface_conformance.py"], "owned_paths": ["AI_ASSISTANTS.md", "docs/assistant-compatibility.md", "templates/target/**", "tools/check_assistant_surface_conformance.py"]},
    {"id": "bridge-capability-matrix", "command": ["tools/check_bridge_capability_matrix.py"], "owned_paths": ["framework/bridge-capability-matrix.md", "templates/target/.ai/assistant/bridge-capability-matrix.md", "tools/check_bridge_capability_matrix.py"]},
    {"id": "change-packages", "command": ["tools/check_change_packages.py"], "owned_paths": ["framework/change-packages.md", "templates/target/.ai/assistant/change-packages/**", "tools/check_change_packages.py"]},
    {"id": "code-documentation", "command": ["tools/check_code_documentation.py"], "owned_paths": ["framework/code-documentation.md", "templates/target/.ai/project/documentation/**", "tools/check_code_documentation.py"]},
    {"id": "project-vocabulary", "command": ["tools/check_project_vocabulary.py"], "owned_paths": ["framework/project-vocabulary.md", "templates/target/.ai/project/vocabulary/**", "tools/check_project_vocabulary.py"]},
    {"id": "test-first-development", "command": ["tools/check_test_first_development.py"], "owned_paths": ["framework/test-first-development.md", "templates/target/.ai/project/testing/**", "tools/check_test_first_development.py"]},
    {"id": "extensions", "command": ["tools/check_extensions.py"], "owned_paths": ["framework/extensions.md", "templates/extension/**", "templates/target/.ai/assistant/extensions/**", "tools/check_extensions.py"]},
    {"id": "dependency-knowledge", "command": ["tools/check_dependency_knowledge.py"], "owned_paths": ["framework/dependency-knowledge.md", "schemas/alatyr-dependency-knowledge.schema.json", "templates/dependency-knowledge/**", "templates/target/.ai/project/dependencies/**", "templates/target/.ai/assistant/**/*dependency-knowledge*", "tools/validate_dependency_knowledge_export.py", "tools/check_dependency_knowledge.py"]},
    {"id": "workspace-modes", "command": ["tools/check_workspace_modes.py"], "owned_paths": ["framework/workspace-modes.md", "templates/target/.ai/project/workspace-modes/**", "templates/target/.ai/assistant/**/*workspace-mode*", "tools/check_workspace_modes.py", "tools/validate_target_adapter.py"]},
    {"id": "assistant-capability-index", "command": ["tools/render_assistant_capability_index.py"], "owned_paths": ["docs/assistant-compatibility.md", "templates/target/.ai/assistant/assistant-capabilities.json", "tools/render_assistant_capability_index.py"]},
    {"id": "captured-effectiveness-results", "command": ["tools/check_captured_effectiveness_results.py"], "owned_paths": ["conformance/benchmarks/results/**", "tools/check_captured_effectiveness_results.py"]},
    {"id": "context-router", "command": ["tools/check_context_router.py"], "profiles": ["fast", "full"], "owned_paths": ["framework/context-*.md", "templates/target/.ai/assistant/context*/**", "tools/check_context_router.py"], "trigger_paths": ["framework/context-*.md", "templates/target/.ai/assistant/context*/**", "tools/check_context_router.py"]},
    {"id": "bootstrap-routing", "command": ["tools/check_bootstrap_routing.py"], "profiles": ["fast", "full", "platform"], "owned_paths": ["templates/target/AGENTS.md", "templates/target/.ai/README.md", "templates/target/.ai/alatyr.yaml", "templates/target/.ai/assistant/bootstrap-index.json", "templates/target/.ai/assistant/context*/**", "templates/target/.ai/assistant/gates/**", "tools/bootstrap_index.py", "tools/render_target_bootstrap_index.py", "tools/check_bootstrap_routing.py", "tools/scaffold*.py"], "depends_on": ["context-router"]},
    {"id": "context-costs", "command": ["tools/check_context_costs.py"], "profiles": ["fast", "full"], "owned_paths": ["framework/context-*.md", "templates/target/.ai/assistant/context*/**", "conformance/golden/context-cost-baseline.json", "tools/*context_costs.py"], "depends_on": ["context-router"]},
    {"id": "discussion-diagrams", "command": ["tools/check_discussion_diagrams.py"], "owned_paths": ["framework/diagram*.md", "templates/target/.ai/assistant/**/*diagram*", "tools/check_discussion_diagrams.py"]},
    {"id": "prepare-diagram-conformance", "command": ["tools/prepare_diagram_conformance_run.py", "--check"], "owned_paths": ["conformance/diagrams/**", "tools/prepare_diagram_conformance_run.py"]},
    {"id": "diagram-conformance-results", "command": ["tools/check_diagram_conformance_results.py"], "owned_paths": ["conformance/diagrams/**", "tools/check_diagram_conformance_results.py"], "depends_on": ["prepare-diagram-conformance"]},
    {"id": "consistency-map", "command": ["tools/check_consistency_map.py"], "owned_paths": ["framework/logical-integrity.md", "templates/target/.ai/project/consistency-map.json", "tools/check_consistency_map.py"]},
    {"id": "cross-platform-tools", "command": ["tools/check_cross_platform_tools.py"], "profiles": ["full", "platform"], "owned_paths": [".github/workflows/**", "requirements*.txt", "tools/alatyr.*", "tools/tool_commands.json", "tools/clean_local_artifacts.py", "tools/plan_target_upgrade.py", "tools/check_cross_platform_tools.py"]},
    {"id": "large-task-orchestration", "command": ["tools/check_large_task_orchestration.py"], "owned_paths": ["framework/large-task-orchestration.md", "templates/target/.ai/assistant/context/task-scales/**", "tools/check_large_task_orchestration.py"]},
    {"id": "subagent-delegation", "command": ["tools/check_subagent_delegation.py"], "owned_paths": ["framework/subagent-delegation.md", "framework/large-task-orchestration.md", "framework/bridge-capability-matrix.md", "templates/target/.ai/assistant/delegation-policy.json", "templates/target/.ai/assistant/context/task-scales/delegated-execution.json", "templates/target/.ai/assistant/assistant-capabilities/**", "templates/target/.ai/assistant/bridge-capability-matrix.md", "templates/target/.ai/assistant/flows/subagent-delegation.flow.md", "templates/target/.ai/assistant/templates/subagent-task-packet.md", "tools/check_subagent_delegation.py"]},
    {"id": "manifest-contract", "command": ["tools/check_manifest_contract.py"], "profiles": ["fast", "full", "platform"], "owned_paths": ["templates/target/.ai/alatyr.yaml", "schemas/alatyr-adapter.schema.json", "tools/check_manifest_contract.py", "tools/target_validation_support.py"]},
    {"id": "markdown-links", "command": ["tools/check_markdown_links.py"], "profiles": ["fast", "full"], "owned_paths": ["**/*.md", "tools/check_markdown_links.py"]},
    {"id": "maturity-profile", "command": ["tools/check_maturity_profile.py"], "owned_paths": ["framework/maturity-model.md", "templates/target/.ai/assistant/maturity-profile.md", "tools/check_maturity_profile.py"]},
    {"id": "module-profile", "command": ["tools/check_module_profile.py"], "owned_paths": ["framework/module-profile.md", "framework/capabilities.json", "templates/target/.ai/assistant/module-profile.md", "tools/check_module_profile.py"]},
    {"id": "capability-graph", "command": ["tools/check_capability_graph.py"], "profiles": ["fast", "full"], "owned_paths": ["framework/capabilities.json", "framework/framework-packs.json", "schemas/alatyr-capabilities.schema.json", "templates/target/.ai/assistant/module-profile.md", "tools/capability_catalog.py", "tools/check_capability_graph.py", "tools/check_manifest.json"], "depends_on": ["framework-packs", "module-profile", "check-manifest"]},
    {"id": "framework-packs", "command": ["tools/check_framework_packs.py"], "profiles": ["fast", "full"], "owned_paths": ["framework/framework-packs.json", "framework/capabilities.json", "tools/framework_packaging.py", "tools/check_framework_packs.py", "tools/scaffold_target_structure.py"], "depends_on": ["framework-metadata", "rule-registry-docs"]},
    {"id": "migration-diff-report", "command": ["tools/check_migration_diff_report.py"], "owned_paths": ["framework/migration-diff.md", "tools/report_migration_diff.py", "tools/plan_target_upgrade.py", "tools/check_migration_diff_report.py"]},
    {"id": "operation-contracts", "command": ["tools/check_operation_contracts.py"], "owned_paths": ["framework/installed-operations.md", "templates/target/.ai/assistant/flows/**", "tools/check_operation_contracts.py"]},
    {"id": "operation-catalog", "command": ["tools/check_operation_catalog.py"], "owned_paths": ["templates/target/.ai/assistant/operation-catalog.json", "tools/check_operation_catalog.py"]},
    {"id": "operation-index", "command": ["tools/render_operation_index.py"], "owned_paths": ["templates/target/.ai/assistant/operation-*.json", "tools/render_operation_index.py"], "depends_on": ["operation-catalog"]},
    {"id": "operation-help", "command": ["tools/check_operation_help.py"], "owned_paths": ["framework/operation-help.md", "templates/target/.ai/assistant/help*.md", "tools/check_operation_help.py"]},
    {"id": "output-contracts", "command": ["tools/check_output_contracts.py"], "owned_paths": ["templates/target/.ai/assistant/templates/adapter-output-contracts.md", "tools/check_output_contracts.py"]},
    {"id": "release-migration-template", "command": ["tools/check_release_migration_template.py"], "owned_paths": ["docs/release-migration-report-template.md", "tools/check_release_migration_template.py"]},
    {"id": "rule-registry-docs", "command": ["tools/render_rule_registry_docs.py", "--check"], "profiles": ["fast", "full"], "owned_paths": ["framework/rule-registry.json", "framework/rule-registry.md", "framework/rule-ownership.md", "tools/render_rule_registry_docs.py"]},
    {"id": "rule-ownership", "command": ["tools/check_rule_ownership.py"], "profiles": ["fast", "full"], "owned_paths": ["framework/rule-*", "tools/check_rule_ownership.py"], "depends_on": ["framework-metadata", "rule-registry-docs"]},
    {"id": "scaffold-profiles", "command": ["tools/check_scaffold_profiles.py"], "profiles": ["fast", "full"], "owned_paths": ["tools/scaffold_profiles.json", "tools/scaffold*.py", "tools/check_scaffold_profiles.py", "templates/target/**"], "depends_on": ["context-router", "manifest-contract"]},
    {"id": "source-of-truth-registry", "command": ["tools/check_source_of_truth_registry.py"], "owned_paths": ["framework/source-of-truth-registry.md", "templates/target/.ai/project/source-of-truth-registry.md", "tools/check_source_of_truth_registry.py"]},
    {"id": "target-validator-findings", "command": ["tools/render_target_validator_findings.py", "--check"], "profiles": ["fast", "full"], "owned_paths": ["tools/validate_target_adapter.py", "tools/target_adapter_validation/**", "docs/target-adapter-validator-findings.md", "tools/render_target_validator_findings.py"]},
    {"id": "target-adapter-validator", "command": ["tools/check_target_adapter_validator.py"], "owned_paths": ["tools/validate_target_adapter.py", "tools/target_adapter_validation/**", "tools/check_target_adapter_validator.py", "templates/target/**"], "trigger_paths": ["tools/validate_target_adapter.py", "tools/target_adapter_validation/**", "tools/check_target_adapter_validator.py", "templates/target/.ai/alatyr.yaml", "templates/target/.ai/assistant/bootstrap-index.json", "templates/target/.ai/assistant/context*/**", "templates/target/.ai/assistant/gates/**", "templates/target/.ai/assistant/module-profile.md", "templates/target/.ai/assistant/approvals/**", "templates/target/.ai/assistant/team/**"], "depends_on": ["target-validator-findings"]},
    {"id": "team-collaboration", "command": ["tools/check_team_collaboration.py"], "owned_paths": ["framework/team-collaboration.md", "templates/target/.ai/assistant/team/**", "tools/check_team_collaboration.py"]},
    {"id": "team-collaboration-scenarios", "command": ["tools/check_team_collaboration_scenarios.py"], "owned_paths": ["tools/check_team_collaboration_scenarios.py", "tools/validate_target_adapter.py", "templates/target/.ai/assistant/team/**"], "depends_on": ["team-collaboration"]},
    {"id": "versioning", "command": ["tools/check_versioning.py"], "profiles": ["fast", "full", "release"], "owned_paths": ["VERSION", "ADAPTER_SCHEMA_VERSION", "TEMPLATE_VERSION", "CHANGELOG.md", "README.md", "docs/human/faq.md", "docs/releases/**", "tools/check_versioning.py"]},
    {"id": "bridge-templates", "command": ["tools/check_bridge_templates.py"], "owned_paths": ["templates/target/AI_ASSISTANTS.md", "templates/target/.cursor*/**", "templates/target/.github/**", "tools/bridge_template_manifest.json", "tools/check_bridge_templates.py"]},
    {"id": "render-bridge-templates", "command": ["tools/render_bridge_templates.py"], "owned_paths": ["templates/target/AI_ASSISTANTS.md", "templates/target/.cursor*/**", "tools/render_bridge_templates.py"], "depends_on": ["bridge-templates"]},
    {"id": "conformance-fixtures", "command": ["tools/check_conformance_fixtures.py"], "owned_paths": ["conformance/fixtures/**", "tools/check_conformance_fixtures.py"]},
    {"id": "conformance-reports", "command": ["tools/check_conformance_reports.py"], "owned_paths": ["conformance/**", "tools/check_conformance_reports.py"]},
    {"id": "conformance-matrix", "command": ["tools/check_conformance_matrix.py"], "owned_paths": ["conformance/**", "tools/check_conformance_matrix.py"]},
    {"id": "conformance-summary", "command": ["tools/check_conformance_summary.py"], "owned_paths": ["conformance/**", "tools/check_conformance_summary.py"], "depends_on": ["conformance-matrix"]},
    {"id": "effectiveness-benchmark", "command": ["tools/check_effectiveness_benchmark.py"], "owned_paths": ["conformance/benchmarks/**", "tools/check_effectiveness_benchmark.py"]},
    {"id": "summarize-effectiveness-benchmark", "command": ["tools/summarize_effectiveness_benchmark.py"], "owned_paths": ["conformance/benchmarks/**", "tools/summarize_effectiveness_benchmark.py"], "depends_on": ["effectiveness-benchmark"]},
    {"id": "conformance-scaffold", "command": ["tools/run_conformance_scaffold.py"], "owned_paths": ["conformance/fixtures/**", "tools/scaffold*.py", "tools/run_conformance_scaffold.py", "templates/target/**"], "depends_on": ["scaffold-profiles", "target-adapter-validator"]},
    {"id": "lifecycle-conformance", "command": ["tools/check_lifecycle_conformance.py"], "profiles": ["full", "platform"], "owned_paths": ["conformance/golden/lifecycle/**", "framework/**", "templates/target/**", "tools/check_lifecycle_conformance.py", "tools/scaffold*.py", "tools/validate_target_adapter.py", "tools/target_adapter_validation/**"], "depends_on": ["capability-graph", "scaffold-profiles", "target-adapter-validator"]},
    {"id": "effectiveness-summary-sample", "command": ["tools/summarize_effectiveness_reports.py", "--input", "conformance/golden/effectiveness-sample.json"], "owned_paths": ["conformance/golden/effectiveness-sample.json", "tools/summarize_effectiveness_reports.py"]},
    {"id": "source-context-routing", "command": ["tools/check_source_context_routing.py"], "profiles": ["fast", "full"], "owned_paths": ["AGENTS.md", "README.md", "INSTALL.md", "AI_ASSISTANTS.md", "installer/**", "tools/source_context_router.json", "framework/file-inventory.json", "tools/check_source_context_routing.py"]},
    {"id": "framework-file-inventory", "command": ["tools/render_framework_file_inventory.py", "--check"], "profiles": ["fast", "full"], "owned_paths": ["VERSION", "ADAPTER_SCHEMA_VERSION", "TEMPLATE_VERSION", "framework/**", "tools/render_framework_file_inventory.py"]},
    {"id": "check-manifest", "command": ["tools/check_check_manifest.py"], "profiles": ["fast", "full"], "owned_paths": ["tools/check_manifest.json", "tools/check_all.py", "tools/check_check_manifest.py"], "always_for_changed": true},
    {"id": "source-unit-tests", "command": ["tools/check_source_unit_tests.py"], "profiles": ["fast", "full", "platform"], "owned_paths": ["tests/**", "tools/check_all.py", "tools/check_source_unit_tests.py"], "always_for_changed": true},
    {"id": "framework-consistency", "command": ["tools/check_framework_consistency.py"], "profiles": ["fast", "full"], "owned_paths": ["framework/**", "installer/**", "templates/target/**", "README.md", "AGENTS.md", "INSTALL.md", "AI_ASSISTANTS.md", "tools/check_framework_consistency.py"], "trigger_paths": ["framework/**", "installer/**", "templates/target/**", "README.md", "AGENTS.md", "INSTALL.md", "AI_ASSISTANTS.md", "tools/check_framework_consistency.py"], "always_for_changed": true, "depends_on": ["framework-metadata", "rule-ownership", "source-context-routing", "framework-file-inventory"]},
    {"id": "release-drift-change", "command": ["tools/check_release_drift.py", "--mode", "change", "--from-ref", "{baseline}"], "profiles": ["change"], "owned_paths": ["framework/**", "templates/target/**", "VERSION", "ADAPTER_SCHEMA_VERSION", "TEMPLATE_VERSION", "tools/check_release_drift.py"]},
    {"id": "release-drift-release", "command": ["tools/check_release_drift.py", "--mode", "release"], "profiles": ["release"], "owned_paths": ["framework/**", "templates/target/**", "VERSION", "ADAPTER_SCHEMA_VERSION", "TEMPLATE_VERSION", "CHANGELOG.md", "docs/releases/**", "tools/check_release_drift.py"], "depends_on": ["versioning", "migration-diff-report", "release-migration-template"]}
  ]
}
