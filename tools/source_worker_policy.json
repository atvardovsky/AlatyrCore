{
  "schema_version": 6,
  "policy_kind": "alatyr-source-worker-policy",
  "scope": "source-repository",
  "provider_neutral": true,
  "canonical_rule": "ALATYR-DELEGATION-001",
  "runtime_capability_owner": "active-assistant",
  "fallback_executor": "primary-assistant",
  "tree_policy": {
    "dispatch_owner": "primary-assistant",
    "worker_child_behavior": "primary-preauthorized-read-only",
    "default_max_depth": 1,
    "hard_max_depth": 2,
    "max_total_delegates": 8,
    "max_parallel_delegates": 2,
    "max_children_per_parent": 4,
    "max_context_words_total": 24000,
    "max_retries_total": 2,
    "require_disjoint_coverage_keys": true
  },
  "context_compaction": {
    "mode": "hierarchical-summary",
    "raw_result_loading": "reference-only-unless-review-triggered",
    "summary_propagation": "accepted-summary-only",
    "digest_algorithm": "sha256",
    "require_measured_result_artifacts": true,
    "deduplicate_inherited_context": true,
    "max_result_words_total": 12000,
    "max_primary_summary_words_total": 4000
  },
  "stop_policy": {
    "require_stop_reason": true,
    "evidence_saturation": "stop-when-acceptance-and-required-evidence-are-covered",
    "stop_reason_ids": [
      "scope-covered",
      "evidence-sufficient",
      "coordination-cost-exceeds-benefit",
      "maximum-depth-reached",
      "worker-budget-reached",
      "context-budget-reached",
      "result-budget-reached",
      "primary-context-budget-reached",
      "checkpoint-required",
      "checkpoint-invalid",
      "context-digest-stale",
      "evidence-digest-mismatch",
      "branch-envelope-violation",
      "validation-regression",
      "semantic-decision-required",
      "overlapping-scope",
      "primary-critical-path",
      "capability-unavailable",
      "user-restricted",
      "cancelled-by-primary"
    ]
  },
  "execution_tree_contract": {
    "schema_version": 2,
    "tree_kind": "alatyr-delegation-execution-tree",
    "template_path": "templates/target/.ai/assistant/templates/delegation-execution-tree.json",
    "required_tree_fields": [
      "schema_version",
      "tree_kind",
      "operation_id",
      "recorded_at",
      "base_revision",
      "current_user_authorization",
      "task_profile",
      "policy_revision",
      "capability_evidence",
      "capability_evidence_sha256",
      "aggregate_budget",
      "root_node_id",
      "nodes",
      "edges",
      "primary_convergence"
    ],
    "required_budget_fields": [
      "max_total_delegates",
      "max_parallel_delegates",
      "max_children_per_parent",
      "max_context_words_total",
      "max_result_words_total",
      "max_primary_summary_words_total",
      "max_retries_total",
      "used_total_delegates",
      "used_parallel_delegates",
      "used_context_words",
      "used_result_words",
      "used_primary_summary_words",
      "used_retries"
    ],
    "required_node_fields": [
      "node_id",
      "parent_node_id",
      "packet_id",
      "parent_packet_id",
      "result_id",
      "depth",
      "status",
      "role_id",
      "assistant_surface",
      "dispatch_backend",
      "implementation_level",
      "coverage_key",
      "semantic_scope",
      "changed_fact_ids",
      "canonical_owner_refs",
      "surface_refs",
      "relationship_refs",
      "allowed_actions",
      "write_scope",
      "context_evidence",
      "context_words",
      "max_result_words",
      "max_summary_words",
      "dispatch_group_id",
      "branch_envelope",
      "branch_envelope_sha256",
      "branch_checkpoint",
      "branch_checkpoint_sha256",
      "result_evidence",
      "accepted_summary_evidence",
      "summary_covers_result_ids",
      "satisfied_acceptance_ids",
      "produced_evidence_ids",
      "attempt",
      "result_status",
      "stop_reason_id",
      "child_proposals",
      "overlap_decision"
    ]
  },
  "runtime_capability_contract": {
    "required_fields": [
      "schema_version",
      "status",
      "surface_id",
      "runtime_id",
      "backend_kind",
      "role_ids",
      "max_parallelism",
      "write_isolation",
      "result_delivery",
      "model_binding",
      "verified_at",
      "expires_at",
      "freshness",
      "session_id",
      "evidence"
    ],
    "schema_version": 2,
    "status": "available",
    "backend_kinds": [
      "native-worker",
      "approved-external-dispatcher"
    ],
    "required_role_id": "read-only-auditor",
    "write_isolation": "read-only",
    "result_delivery": true,
    "freshness": "current-session",
    "minimum_parallelism": 2,
    "maximum_age_seconds": 900,
    "maximum_validity_seconds": 1800,
    "maximum_future_skew_seconds": 60
  },
  "activation": {
    "task_classes": ["large-or-resumable"],
    "minimum_independent_packets": 2,
    "repository_audit_candidate_source": "built-in-workstreams",
    "task_specific_candidate_source": "explicit-worker-packets",
    "missing_large_task_packets_decision": "workstream-identification-required",
    "audit_default": "evaluate",
    "fallback_executor": "primary-assistant"
  },
  "decision_evidence": {
    "required_fields": [
      "evaluation_status",
      "runtime_capability_status",
      "selected_workstream_ids",
      "decision",
      "reason",
      "skip_reason_id"
    ],
    "preflight_decisions": [
      "runtime-verification-required",
      "workstream-identification-required",
      "delegation-recommended",
      "kept-local",
      "primary-assistant"
    ],
    "completion_decisions": [
      "delegated",
      "kept-local"
    ],
    "skip_reason_ids": [
      "capability-unavailable",
      "capability-unverified",
      "insufficient-independent-work",
      "dependency-ordering",
      "overlapping-scope",
      "coordination-cost-exceeds-benefit",
      "client-policy-prohibits",
      "user-restricted"
    ],
    "decision_rules": {
      "runtime-verification-required": {
        "skip_reason": "forbidden",
        "allowed_skip_reason_ids": []
      },
      "workstream-identification-required": {
        "skip_reason": "required",
        "allowed_skip_reason_ids": ["insufficient-independent-work"]
      },
      "delegation-recommended": {
        "skip_reason": "forbidden",
        "allowed_skip_reason_ids": []
      },
      "kept-local": {
        "skip_reason": "required",
        "allowed_skip_reason_ids": [
          "capability-unavailable",
          "capability-unverified",
          "dependency-ordering",
          "overlapping-scope",
          "coordination-cost-exceeds-benefit",
          "client-policy-prohibits",
          "user-restricted"
        ]
      },
      "primary-assistant": {
        "skip_reason": "required",
        "allowed_skip_reason_ids": ["insufficient-independent-work"]
      }
    }
  },
  "worker_packet_contract": {
    "schema_version": 5,
    "packet_kinds": ["source-read-only-workstream"],
    "required_fields": [
      "schema_version",
      "packet_kind",
      "parent_packet_id",
      "depth",
      "remaining_worker_budget",
      "coverage_key",
      "child_dispatch_mode",
      "branch_envelope_sha256",
      "workstream_id",
      "role_id",
      "objective",
      "bounded_context",
      "max_initial_words",
      "max_result_words",
      "max_summary_words",
      "parent_context_packet_sha256",
      "context_delta",
      "conditional_context",
      "non_goals",
      "allowed_actions",
      "write_scope",
      "independent",
      "independence_key",
      "semantic_scope",
      "changed_fact_ids",
      "canonical_owner_refs",
      "surface_refs",
      "relationship_refs",
      "overlap_decision",
      "expected_evidence"
    ],
    "allowed_actions": [
      "inspect"
    ],
    "role_id": "read-only-auditor",
    "write_scope": "none",
    "child_dispatch_modes": [
      "none",
      "propose-only",
      "primary-preauthorized-read-only"
    ],
    "result_requirement": "Return a schema-1 normalized result with measured raw and accepted-summary artifacts. Keep raw payloads reference-only by default, bind summaries and child results by SHA-256, and create a branch checkpoint for recursive work. Do not decide integration or mutate repository state."
  },
  "workstreams": {
    "framework-rules": {
      "objective": "Review portable rules, canonical ownership, semantic references, and framework indexes for contradictions or drift.",
      "mode": "read-only",
      "independent": true,
      "independence_key": "portable-framework-rules",
      "semantic_scope": "portable-framework-rules",
      "changed_fact_ids": [],
      "canonical_owner_refs": [
        "framework/rule-registry.json",
        "framework/rule-ownership.md"
      ],
      "surface_refs": [
        "framework/**",
        "framework/catalog/**"
      ],
      "relationship_refs": [
        "framework/context-index.json",
        "framework/semantics/index.json"
      ],
      "overlap_decision": "disjoint",
      "required_context": [
        "framework/context-index.json",
        "framework/semantics/index.json"
      ],
      "max_initial_words": 4000,
      "max_result_words": 1600,
      "max_summary_words": 600,
      "conditional_context": [
        "framework/rule-registry.json entry selected by a relevant rule ID",
        "framework/rule-ownership.md entry selected by a relevant rule ID",
        "canonical owners selected by a relevant rule ID",
        "direct dependencies selected by framework metadata"
      ],
      "non_goals": [
        "editing framework rules",
        "resolving cross-owner conflicts",
        "changing target templates"
      ],
      "expected_evidence": "Severity-ranked findings with canonical-owner and path references."
    },
    "installation-surfaces": {
      "objective": "Review installer routing, target projections, assistant bridges, and adapter-contract alignment.",
      "mode": "read-only",
      "independent": true,
      "independence_key": "installation-and-target-projections",
      "semantic_scope": "installation-and-target-projections",
      "changed_fact_ids": [],
      "canonical_owner_refs": [
        "INSTALL.md",
        "installer/assistant-installation.flow.md"
      ],
      "surface_refs": [
        "installer/**",
        "templates/target/**"
      ],
      "relationship_refs": [
        "framework/capabilities.json",
        "tools/scaffold_profiles.json"
      ],
      "overlap_decision": "disjoint",
      "required_context": [
        "installer/context-router.json",
        "templates/target/.ai/README.md"
      ],
      "max_initial_words": 4000,
      "max_result_words": 1600,
      "max_summary_words": 600,
      "conditional_context": [
        "INSTALL.md section selected by the installer stage or detected ambiguity",
        "installer/assistant-installation.flow.md stage selected by the detected mismatch",
        "selected target template or bridge",
        "canonical framework owner for a detected mismatch"
      ],
      "non_goals": [
        "installing AlatyrCore",
        "rewriting target-project facts",
        "changing portable contracts"
      ],
      "expected_evidence": "Findings that distinguish source, installer, template, and target-owned responsibilities."
    },
    "source-tooling": {
      "objective": "Review source tools, check routing, manifests, validators, and generated-evidence contracts.",
      "mode": "read-only",
      "independent": true,
      "independence_key": "source-tools-and-validation",
      "semantic_scope": "source-tools-and-validation",
      "changed_fact_ids": [],
      "canonical_owner_refs": [
        "tools/check_manifest.json",
        "docs/source-architecture.md"
      ],
      "surface_refs": [
        "tools/**",
        "tests/**",
        "docs/source-architecture.md"
      ],
      "relationship_refs": [
        "tools/source_context_router.json",
        "tools/source_worker_policy.json"
      ],
      "overlap_decision": "disjoint",
      "required_context": [
        "tools/source_context_router.json",
        "tools/tool_commands.json",
        "docs/source-architecture.md"
      ],
      "max_initial_words": 4000,
      "max_result_words": 1600,
      "max_summary_words": 600,
      "conditional_context": [
        "selected tools/check_manifest.json entry",
        "selected tools/README.md command section",
        "checker selected by a failed check ID",
        "implementation helper listed by the manifest route"
      ],
      "non_goals": [
        "weakening validation",
        "editing generated evidence",
        "running live external actions"
      ],
      "expected_evidence": "Checker, route, dependency, and coverage findings with reproducible commands where useful."
    },
    "public-and-release": {
      "objective": "Review public documentation, maintainer guidance, versions, changelog, and release evidence for consistent claims.",
      "mode": "read-only",
      "independent": true,
      "independence_key": "public-and-release-evidence",
      "semantic_scope": "public-and-release-evidence",
      "changed_fact_ids": [],
      "canonical_owner_refs": [
        "README.md",
        "CHANGELOG.md",
        "docs/release-process.md"
      ],
      "surface_refs": [
        "README.md",
        "CHANGELOG.md",
        "docs/human/**",
        "docs/releases/**",
        "VERSION",
        "ADAPTER_SCHEMA_VERSION",
        "TEMPLATE_VERSION"
      ],
      "relationship_refs": [
        "docs/release-process.md",
        "tools/check_versioning.py"
      ],
      "overlap_decision": "disjoint",
      "required_context": [
        "VERSION",
        "docs/release-process.md"
      ],
      "max_initial_words": 4000,
      "max_result_words": 1600,
      "max_summary_words": 600,
      "conditional_context": [
        "README.md section selected by a disputed public claim",
        "current CHANGELOG.md release section selected by version evidence",
        "release note or migration evidence selected by a detected version mismatch",
        "canonical rule owner for a disputed public claim"
      ],
      "non_goals": [
        "publishing a release",
        "changing repository settings",
        "making unsupported product claims"
      ],
      "expected_evidence": "Claim, version, lifecycle, and discoverability findings with exact source references."
    }
  },
  "primary_owned_actions": [
    "task-profile-selection",
    "runtime-capability-verification",
    "worker-packet-approval",
    "architecture-decisions",
    "conflict-resolution",
    "logical-integrity-review",
    "result-verification",
    "final-synthesis",
    "final-validation",
    "current-scope-authorization",
    "modify",
    "commit",
    "publish",
    "live-external"
  ],
  "authorization_boundary": "Worker capability and delegation do not grant inspect, modify, commit, publish, live-external, approval, permission, or scope authority beyond the current user request."
}
